{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The API tier as a developer runs it on this host:
  //
  //   dotnet run --project Survsys.Api --urls http://localhost:5100
  //
  // The port is named rather than left to Kestrel's default because both
  // tiers would otherwise ask for the same one and the second to start would
  // fail. The walkthrough harness supplies this value itself, on ports it
  // found free, and never reads this file.
  "Survsys": {
    "ApiBaseAddress": "http://localhost:5100"
  }
}
