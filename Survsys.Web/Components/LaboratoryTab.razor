    /// <summary>
    /// Asks the operator to confirm a removal before it is sent, so a delete is
    /// never one click away. True only where they chose to go ahead.
    /// </summary>
    private async Task<bool> Confirm(string title, string message) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: "Delete", cancelText: "Cancel") == true;

    /// <summary>Empties the entry form after a specimen is recorded.</summary>
    private void Clear()
    {
        specimenForm = new SpecimenForm();
        tests = [];
        resistTests = [];
    }

    /// <summary>A value as the list shows it, or a dash for what nobody has recorded.</summary>
    private static string Shown(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>An identifier as the list shows it, or a dash where none is recorded.</summary>
    private static string Shown(int? value) =>
        value is { } id ? id.ToString(CultureInfo.InvariantCulture) : "—";

    /// <summary>A three-state flag as the list shows it.</summary>
    private static string Flag(bool? value) => value switch
    {
        true => "Yes",
        false => "No",
        null => "—",
    };

    /// <summary>A coded box's content, trimmed, or null where it holds nothing.</summary>
    private static string? Blank(string? typed) =>
        string.IsNullOrWhiteSpace(typed) ? null : typed.Trim();

    /// <summary>
    /// A date box read: empty is no date, a date is the date, and anything
    /// else is a complaint naming the box — the same rule the other tabs read
    /// their date boxes by.
    /// </summary>
    private static bool TryDate(string? typed, string named, out DateOnly? date, out string? why)
    {
        date = null;
        why = null;

        if (string.IsNullOrWhiteSpace(typed))
        {
            return true;
        }

        if (DateOnly.TryParseExact(typed.Trim(), DateForm, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var parsed))
        {
            date = parsed;

            return true;
        }

        why = $"Give {named} as yyyy-mm-dd, or leave it empty.";

        return false;
    }

    /// <summary>A date as a date box holds it.</summary>
    private static string? Written(DateOnly? date) =>
        date?.ToString(DateForm, CultureInfo.InvariantCulture);

