    /// <summary>
    /// Asks the operator to confirm a removal before it is sent, so a delete is
    /// never one click away. True only where they chose to go ahead.
    /// </summary>
    private async Task<bool> Confirm(string title, string message) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: "Delete", cancelText: "Cancel") == true;

    /// <summary>Empties the entry form after a specimen is recorded.</summary>
    private void Clear()
    {
        specimenForm = new SpecimenForm();
        tests = [];
        resistTests = [];
        newClinician = null;
        noClinicianMatched = false;
    }

    /// <summary>A value as the list shows it, or a dash for what nobody has recorded.</summary>
    private static string Shown(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>An identifier as the list shows it, or a dash where none is recorded.</summary>
    private static string Shown(int? value) =>
        value is { } id ? id.ToString(CultureInfo.InvariantCulture) : "—";

    /// <summary>A facility as the list shows it: its short name, else its name, else its id.</summary>
    private string FacilityName(int? id) =>
        facilities.FirstOrDefault(facility => facility.Id == id) is { } facility
            ? facility.ShortName ?? facility.Name
            : Shown(id);

    /// <summary>
    /// A clinician as the list and the search show them — last name, then
    /// first — or #id for one the registry does not hold, and nothing for none.
    /// </summary>
    private string ClinicianName(int? id) =>
        id is not { } chosen
            ? ""
            : clinicians.TryGetValue(chosen, out var provider)
                ? provider.LastName + (string.IsNullOrWhiteSpace(provider.FirstName) ? "" : $", {provider.FirstName}")
                : $"#{chosen.ToString(CultureInfo.InvariantCulture)}";

    /// <summary>A specimen source as the list shows it: its description, else its id.</summary>
    private string SourceName(int? id) =>
        sources.FirstOrDefault(source => source.Id == id) is { } source
            ? source.Description ?? source.Code
            : Shown(id);

    /// <summary>The master LOINC codes whose code or concept name holds what was typed.</summary>
    private Task<IEnumerable<string>> SearchLoincs(string? typed, CancellationToken cancellationToken) =>
        Task.FromResult(loincs
            .Where(row => string.IsNullOrWhiteSpace(typed)
                || row.Loinc.Contains(typed.Trim(), StringComparison.OrdinalIgnoreCase)
                || row.ConceptName?.Contains(typed.Trim(), StringComparison.OrdinalIgnoreCase) == true)
            .Select(row => row.Loinc));

    /// <summary>A master LOINC code's concept name, or nothing for a code the vocabulary does not hold.</summary>
    private string? ConceptName(string? code) =>
        loincs.FirstOrDefault(row => row.Loinc == code)?.ConceptName;

    /// <summary>A three-state flag as the list shows it.</summary>
    private static string Flag(bool? value) => value switch
    {
        true => "Yes",
        false => "No",
        null => "—",
    };

    /// <summary>A coded box's content, trimmed, or null where it holds nothing.</summary>
    private static string? Blank(string? typed) =>
        string.IsNullOrWhiteSpace(typed) ? null : typed.Trim();

    /// <summary>
    /// A date box read: empty is no date, a date is the date, and anything
    /// else is a complaint naming the box — the same rule the other tabs read
    /// their date boxes by.
    /// </summary>
    private static bool TryDate(string? typed, string named, out DateOnly? date, out string? why)
    {
        date = null;
        why = null;

        if (string.IsNullOrWhiteSpace(typed))
        {
            return true;
        }

        if (DateOnly.TryParseExact(typed.Trim(), DateForm, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var parsed))
        {
            date = parsed;

            return true;
        }

        why = $"Give {named} as yyyy-mm-dd, or leave it empty.";

        return false;
    }

    /// <summary>A date as a date box holds it.</summary>
    private static string? Written(DateOnly? date) =>
        date?.ToString(DateForm, CultureInfo.InvariantCulture);

