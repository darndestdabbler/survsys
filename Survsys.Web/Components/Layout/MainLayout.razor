@* The frame every screen is drawn in. MudThemeProvider has to be somewhere
   above every MudBlazor component or none of them is styled, and the layout
   is the place it is above all of them. The app bar carries the application's
   name and nothing clickable: there is one screen, so there is nothing yet to
   navigate between, and a navigation menu with one entry would be a control a
   walkthrough has no reason to name. *@
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Survsys</MudText>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
