@* The Demographic tab of a case morbidity report: the person's record,
   editable, and saved whole.

   ../nedss/docs/functional/epitrax-cmr-workflow.md records the legacy tab's
   six sections -- Name, Age, Addresses, Telephones, Email Addresses and
   Demographics -- and this is those six, in that order, with the person's
   former names under Name and their identifiers after it. Every coded field
   (gender, language, ethnicity, race, state, county, residence type,
   telephone type, country) is a text box holding the legacy code, because
   the reference tables behind the legacy dropdowns do not exist yet and a
   dropdown over a guess at them would be a dropdown to unpick later.

   The person arrives as a parameter and is copied into fields on
   initialisation, so that typing changes the fields and never the record
   the shell holds. Save & Continue builds the whole record from the fields
   and sends it as one PUT; what comes back replaces the fields, so the
   screen shows what was stored -- the identifiers the save assigned to the
   rows included -- and not what it sent.

   The ages are computed and never stored: current age from today, age at
   onset from the report's event onset date, both through Age.InYears over
   whatever the date of birth box holds at the moment.

   Every element a walkthrough names carries an identifier; a row in a list
   carries its position, demographics-address-0-street and so on. *@
@using System.Globalization
@inject PersonsClient Persons
@inject IConfiguration Configuration

@if (saved is { } stored)
{
    <MudAlert id="demographics-saved" Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
        @stored
    </MudAlert>
}

@if (failure is { } whyNot)
{
    <MudAlert id="demographics-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        @whyNot
    </MudAlert>
}

@if (complaint is { } whyNotYet)
{
    <MudAlert id="demographics-complaint" Severity="Severity.Warning" Class="mb-4">
        @whyNotYet
    </MudAlert>
}

<MudPaper id="demographics-name" Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Name</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="lastName" id="demographics-last-name"
                          Label="Last name" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="firstName" id="demographics-first-name"
                          Label="First name" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="middleName" id="demographics-middle-name"
                          Label="Middle name" Variant="Variant.Outlined" />
        </MudItem>
    </MudGrid>

    <div id="demographics-guardians" class="mt-2">
        <MudText Typo="Typo.subtitle2">Parent/Guardian</MudText>
        @for (var n = 0; n < guardians.Count; n++)
        {
            var at = n;
            <div class="d-flex gap-2 align-center mt-1" @key="guardians[at]">
                <MudTextField @bind-Value="guardians[at].Value" id="@($"demographics-guardian-{at}")"
                              Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton id="@($"demographics-guardian-remove-{at}")" Variant="Variant.Text"
                           Color="Color.Error" OnClick="@(() => guardians.RemoveAt(at))">
                    Remove
                </MudButton>
            </div>
        }
        <MudButton id="demographics-guardian-add" Variant="Variant.Outlined" Class="mt-2"
                   OnClick="@(() => guardians.Add(new Text()))">
            Add parent/guardian
        </MudButton>
    </div>

    @* The other names the person is known by. The legacy tab has no box
       for them, but the record carries them and a save sends the whole
       record, so a save that could not edit them would be resubmitting
       whatever was loaded. *@
    <div id="demographics-aliases" class="mt-2">
        <MudText Typo="Typo.subtitle2">Aliases</MudText>
        @for (var n = 0; n < aliases.Count; n++)
        {
            var at = n;
            <div class="d-flex gap-2 align-center mt-1" @key="aliases[at]">
                <MudTextField @bind-Value="aliases[at].Value" id="@($"demographics-alias-{at}")"
                              Label="Alias" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton id="@($"demographics-alias-remove-{at}")" Variant="Variant.Text"
                           Color="Color.Error" OnClick="@(() => aliases.RemoveAt(at))">
                    Remove
                </MudButton>
            </div>
        }
        <MudButton id="demographics-alias-add" Variant="Variant.Outlined" Class="mt-2"
                   OnClick="@(() => aliases.Add(new Text()))">
            Add alias
        </MudButton>
    </div>

    @* The names the person was on file under before, which a save that
       changes the name records. Shown and never edited: it is a record of
       what the name was. *@
    @if (formerNames.Count > 0)
    {
        <div id="demographics-former-names" class="mt-2">
            <MudText Typo="Typo.subtitle2">Former names</MudText>
            @for (var n = 0; n < formerNames.Count; n++)
            {
                var former = formerNames[n];
                <MudText id="@($"demographics-former-name-{n}")" Typo="Typo.body2">
                    @FormerName(former) — changed @Written(former.ChangedOn)
                </MudText>
            }
        </div>
    }
</MudPaper>

<MudPaper id="demographics-identifiers" Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Identifiers</MudText>
    @for (var n = 0; n < identifiers.Count; n++)
    {
        var at = n;
        var identifier = identifiers[at];
        <MudGrid Spacing="2" Class="mb-2" @key="identifier">
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="identifier.IdentifierType" id="@($"demographics-identifier-{at}-type")"
                              Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="identifier.Value" id="@($"demographics-identifier-{at}-value")"
                              Label="Identifier" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="identifier.AssigningAuthority" id="@($"demographics-identifier-{at}-authority")"
                              Label="Assigning authority" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                @* What the authority is named by: a laboratory by its CLIA
                   number, anything else by its OID. *@
                <MudSelect @bind-Value="identifier.AssigningAuthorityType"
                           id="@($"demographics-identifier-{at}-authority-type")"
                           Label="Authority by" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true">
                    <MudSelectItem Value="@("CLIA")">CLIA</MudSelectItem>
                    <MudSelectItem Value="@("OID")">OID</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton id="@($"demographics-identifier-remove-{at}")" Variant="Variant.Text"
                           Color="Color.Error" OnClick="@(() => identifiers.RemoveAt(at))">
                    Remove
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    <MudButton id="demographics-identifier-add" Variant="Variant.Outlined"
               OnClick="@(() => identifiers.Add(new IdentifierFields()))">
        Add identifier
    </MudButton>
</MudPaper>

<MudPaper id="demographics-age" Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Age</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3">
            @* A native date input, for the reason the search form's is one:
               what it yields is what the other tier parses. *@
            <MudTextField @bind-Value="birthDate" id="demographics-birth-date"
                          Label="Date of birth" Variant="Variant.Outlined"
                          InputType="InputType.Date" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="daysOld" id="demographics-days-old"
                          Label="Days old (no birthday)" Variant="Variant.Outlined"
                          InputType="InputType.Number" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption">Current age</MudText>
            <MudText id="demographics-current-age" Typo="Typo.body1">@CurrentAge</MudText>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption">Age at onset</MudText>
            <MudText id="demographics-age-at-onset" Typo="Typo.body1">@AgeAtOnset</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper id="demographics-addresses" Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Addresses</MudText>
    @for (var n = 0; n < addresses.Count; n++)
    {
        var at = n;
        var address = addresses[at];
        <MudGrid Spacing="2" Class="mb-2" @key="address">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="address.Street" id="@($"demographics-address-{at}-street")"
                              Label="Street" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="address.UnitNumber" id="@($"demographics-address-{at}-unit-number")"
                              Label="Unit number" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="address.City" id="@($"demographics-address-{at}-city")"
                              Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <CodeSelect List="@CodeLists.State" @bind-Value="address.State" id="@($"demographics-address-{at}-state")"
                            Label="State" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="address.PostalCode" id="@($"demographics-address-{at}-postal-code")"
                              Label="Zip code" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <CodeSelect List="@CodeLists.County" Kind="county" @bind-Value="address.County"
                            id="@($"demographics-address-{at}-county")" Label="County" Margin="Margin.Dense" />
            </MudItem>
            @if (address.State == "CT")
            {
                <MudItem xs="12" sm="2">
                    <CodeSelect List="@CodeLists.County" Kind="county-equivalent" @bind-Value="address.CountyEquivalent"
                                id="@($"demographics-address-{at}-county-equivalent")"
                                Label="@AddressLabels.CountyEquivalent(Configuration)" Margin="Margin.Dense" />
                </MudItem>
            }
            <MudItem xs="12" sm="2">
                <CodeSelect List="@CodeLists.ResidenceType" @bind-CodeId="address.ResidenceType"
                            id="@($"demographics-address-{at}-residence-type")"
                            Label="Residence type" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="address.Beginning" id="@($"demographics-address-{at}-beginning")"
                              Label="Earliest known" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputType="InputType.Date" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="address.Ending" id="@($"demographics-address-{at}-ending")"
