<div class="d-flex gap-2">
    <MudButton id="demographics-save" Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@saving" OnClick="@Save">
        Save &amp; Continue
    </MudButton>
</div>

@code {
    /// <summary>The person this tab edits, as the shell read them.</summary>
    [Parameter, EditorRequired]
    public PersonDetailResponse Person { get; set; } = default!;

    /// <summary>The report's event onset date, for the age at onset.</summary>
    [Parameter]
    public DateOnly? EventOnsetDate { get; set; }

    /// <summary>
    /// How this tier writes a date into a date box and reads one out: the
    /// form a native date input yields, under the culture the other tier
    /// parses it with.
    /// </summary>
    private const string DateForm = "yyyy-MM-dd";

    private string? lastName;

    private string? firstName;

    private string? middleName;

    private List<Text> guardians = [];

    private List<Text> aliases = [];

    private string? birthDate;

    private int? daysOld;

    private List<AddressFields> addresses = [];

    private List<TelephoneFields> telephones = [];

    private List<EmailFields> emails = [];

    private List<IdentifierFields> identifiers = [];

    private IReadOnlyList<PersonFormerNameResponse> formerNames = [];

    private string? birthGender;

    private string? currentGender;

    private string? language;

    private string? ethnicity;

    private List<Text> races = [];

    private string? countryOfBirth;

    private bool saving;

    private string? saved;

    private string? failure;

    private string? complaint;

    protected override void OnInitialized() => Load(Person);

    /// <summary>
    /// Copies a person into the fields: on arrival, and again with what a
    /// save answered.
    /// </summary>
    private void Load(PersonDetailResponse person)
    {
        lastName = person.LastName;
        firstName = person.FirstName;
        middleName = person.MiddleName;
        guardians = person.ParentGuardians.Select(name => new Text { Value = name }).ToList();
        aliases = person.Aliases.Select(name => new Text { Value = name }).ToList();
        birthDate = Written(person.BirthDate);
        daysOld = person.DaysOldNoBirthday;
        addresses = person.Addresses.Select(address => new AddressFields
        {
            Street = address.Street,
            UnitNumber = address.UnitNumber,
            City = address.City,
            State = address.State,
            PostalCode = address.PostalCode,
            County = address.County,
            CountyEquivalent = address.CountyEquivalent,
            ResidenceType = address.ResidenceTypeId,
            Beginning = Written(address.Beginning),
            Ending = Written(address.Ending),
            Note = address.Note,
        }).ToList();
        telephones = person.Telephones.Select(telephone => new TelephoneFields
        {
            TelephoneType = telephone.TelephoneType,
            CountryCode = telephone.CountryCode,
            AreaCode = telephone.AreaCode,
            PhoneNumber = telephone.PhoneNumber,
            Extension = telephone.Extension,
            Beginning = Written(telephone.Beginning),
            Note = telephone.Note,
        }).ToList();
        emails = person.Emails.Select(email => new EmailFields
        {
            EmailAddress = email.EmailAddress,
            Current = email.CurrentEmail,
        }).ToList();
        formerNames = person.FormerNames;
        identifiers = person.Identifiers.Select(identifier => new IdentifierFields
        {
            IdentifierType = identifier.IdentifierType,
            Value = identifier.Value,
            AssigningAuthority = identifier.AssigningAuthority,
            AssigningAuthorityType = identifier.AssigningAuthorityType,
        }).ToList();
        birthGender = person.BirthGender;
        currentGender = person.CurrentGender;
        language = person.Language;
        ethnicity = person.Ethnicity;
        races = person.Races.Select(code => new Text { Value = code }).ToList();
        countryOfBirth = person.CountryOfBirth;
    }

    /// <summary>The current age, from whatever the date of birth box holds today.</summary>
    private string CurrentAge => Years(DateOnly.FromDateTime(DateTime.Today));

    /// <summary>The age at the report's event onset, or nothing where the report has no date.</summary>
    private string AgeAtOnset => EventOnsetDate is { } onset ? Years(onset) : "—";

    private string Years(DateOnly on) =>
        Age.InYears(Parsed(birthDate), daysOld, on) is { } years ? years.ToString() : "—";

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(lastName))
        {
            complaint = "Give the person's last name: it is the one name part this record requires.";

            return;
        }

        if (!TryDate(birthDate, "the date of birth", out var born, out var why)
            || !Rows(out var sentAddresses, out var sentTelephones, out why)
            || !Identifiers(out var sentIdentifiers, out why))
        {
            complaint = why;

            return;
        }

        complaint = null;
        failure = null;
        saved = null;
        saving = true;

        try
        {
            var answered = await Persons.Update(Person.Id, new UpdatePersonRequest(
                LastName: lastName,
                FirstName: firstName,
                MiddleName: middleName,
                BirthDate: born,
                DaysOldNoBirthday: daysOld,
                BirthGender: birthGender,
                CurrentGender: currentGender,
                Ethnicity: ethnicity,
                Language: language,
                CountryOfBirth: countryOfBirth)
            {
                Races = races.Select(race => race.Value ?? string.Empty).ToList(),
                Aliases = aliases.Select(alias => alias.Value ?? string.Empty).ToList(),
                ParentGuardians = guardians.Select(guardian => guardian.Value ?? string.Empty).ToList(),
                Addresses = sentAddresses,
                Telephones = sentTelephones,
                Emails = emails.Select(email => new PersonEmailRequest(email.EmailAddress, email.Current)).ToList(),
                Identifiers = sentIdentifiers,
            });

            if (answered.Value is { } stored)
            {
                Load(stored);
                saved = "The demographics have been saved.";
            }
            else
            {
                failure = answered.Failure;
            }
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>
    /// The address and telephone rows as the request takes them, with each
    /// date box read — or why one of them could not be.
    /// </summary>
    private bool Rows(
        out List<PersonAddressRequest> sentAddresses,
        out List<PersonTelephoneRequest> sentTelephones,
        out string? why)
    {
        sentAddresses = [];
        sentTelephones = [];

        for (var n = 0; n < addresses.Count; n++)
        {
            var address = addresses[n];

            if (!TryDate(address.Beginning, $"address {n + 1}'s earliest known date", out var beginning, out why)
                || !TryDate(address.Ending, $"address {n + 1}'s moved date", out var ending, out why))
            {
                return false;
            }

            sentAddresses.Add(new PersonAddressRequest(
                Street: address.Street,
                UnitNumber: address.UnitNumber,
                City: address.City,
                State: address.State,
                PostalCode: address.PostalCode,
                County: address.County,
                Beginning: beginning,
                Ending: ending,
                Note: address.Note,
                ResidenceTypeId: address.ResidenceType,
                CountyEquivalent: address.CountyEquivalent));
        }

        for (var n = 0; n < telephones.Count; n++)
        {
            var telephone = telephones[n];

            if (!TryDate(telephone.Beginning, $"telephone {n + 1}'s earliest known date", out var beginning, out why))
            {
                return false;
            }

            sentTelephones.Add(new PersonTelephoneRequest(
                TelephoneType: telephone.TelephoneType,
                CountryCode: telephone.CountryCode,
                AreaCode: telephone.AreaCode,
                PhoneNumber: telephone.PhoneNumber,
                Extension: telephone.Extension,
                Beginning: beginning,
                Note: telephone.Note));
        }

        why = null;

        return true;
    }

    /// <summary>
    /// The identifier rows as the request takes them — a row left wholly
    /// blank is dropped, and one with something in it but no identifier is a
    /// complaint naming it, because the record refuses an identifier that is
    /// nothing.
    /// </summary>
    private bool Identifiers(out List<PersonIdentifierRequest> sent, out string? why)
    {
        sent = [];
        why = null;

        for (var n = 0; n < identifiers.Count; n++)
        {
            var identifier = identifiers[n];

            if (!string.IsNullOrWhiteSpace(identifier.Value))
            {
                sent.Add(new PersonIdentifierRequest(
                    identifier.IdentifierType,
                    identifier.Value,
                    identifier.AssigningAuthority,
                    identifier.AssigningAuthorityType));
            }
            else if (!string.IsNullOrWhiteSpace(identifier.IdentifierType)
                || !string.IsNullOrWhiteSpace(identifier.AssigningAuthority)
                || identifier.AssigningAuthorityType is not null)
            {
                why = $"Give identifier {n + 1}'s identifier, or remove it.";

                return false;
            }
        }

        return true;
    }

    /// <summary>A former name as a list shows it: last, first middle.</summary>
    private static string FormerName(PersonFormerNameResponse former) =>
        string.Join(" ", new[] { $"{former.LastName},", former.FirstName, former.MiddleName }
            .Where(part => !string.IsNullOrWhiteSpace(part)))
            .TrimEnd(',');

    /// <summary>
    /// A date box read: empty is no date, a date is the date, and anything
    /// else is a complaint naming the box.
    /// </summary>
    private static bool TryDate(string? typed, string named, out DateOnly? date, out string? why)
    {
        date = null;
        why = null;

        if (string.IsNullOrWhiteSpace(typed))
        {
            return true;
        }

        if (DateOnly.TryParseExact(typed.Trim(), DateForm, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var parsed))
        {
            date = parsed;

            return true;
        }

        why = $"Give {named} as yyyy-mm-dd, or leave it empty.";

        return false;
    }

    /// <summary>A date box's content as a date, or null while it holds none.</summary>
    private static DateOnly? Parsed(string? typed) =>
        TryDate(typed, string.Empty, out var date, out _) ? date : null;

    /// <summary>A date as a date box holds it.</summary>
    private static string? Written(DateOnly? date) =>
        date?.ToString(DateForm, CultureInfo.InvariantCulture);

    /// <summary>
    /// One text value in a list — a guardian's name, a race code — as an
    /// object rather than a string, so that a box can bind to it and a row
    /// keeps its identity when another is removed.
    /// </summary>
    private sealed class Text
    {
        public string? Value { get; set; }
    }

    /// <summary>One address as its boxes hold it: the dates as text, until they are read.</summary>
    private sealed class AddressFields
    {
        public string? Street { get; set; }
        public string? UnitNumber { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? PostalCode { get; set; }
        public string? County { get; set; }
        public string? CountyEquivalent { get; set; }
        public int? ResidenceType { get; set; }
        public string? Beginning { get; set; }
        public string? Ending { get; set; }
        public string? Note { get; set; }
    }

    /// <summary>One telephone as its boxes hold it.</summary>
    private sealed class TelephoneFields
    {
        public string? TelephoneType { get; set; }
        public string? CountryCode { get; set; }
        public string? AreaCode { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Extension { get; set; }
        public string? Beginning { get; set; }
        public string? Note { get; set; }
    }

    /// <summary>One identifier as its boxes hold it.</summary>
    private sealed class IdentifierFields
    {
        public string? IdentifierType { get; set; }
        public string? Value { get; set; }
        public string? AssigningAuthority { get; set; }
        public string? AssigningAuthorityType { get; set; }
    }

    /// <summary>One email address as its boxes hold it.</summary>
    private sealed class EmailFields
    {
        public string? EmailAddress { get; set; }
        public bool? Current { get; set; }
    }
}
