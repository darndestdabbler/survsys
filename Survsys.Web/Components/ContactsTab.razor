    /// <summary>
    /// Removes the open exposure's place, once confirmed: the exposure is
    /// pointed at no place first, because a place an exposure still points at
    /// cannot be deleted, and then the now-unreferenced place is removed
    /// through its own route. A refusal at either step is shown as the entry
    /// error.
    /// </summary>
    private async Task RemovePlace()
    {
        if (editingId is not { } exposureId || editingPlaceId is not { } placeId)
        {
            return;
        }

        if (!await Confirm("Remove place?", "The place will be removed from the exposure. This cannot be undone."))
        {
            return;
        }

        if (!TryDate(exposureForm.ExposureStart, "the exposure start", out var started, out var why)
            || !TryDate(exposureForm.ExposureEnd, "the exposure end", out var ended, out why))
        {
            complaint = why;

            return;
        }

        complaint = null;
        entryFailure = null;
        saved = null;
        recording = true;

        try
        {
            var detached = await Api.UpdateExposure(exposureId, new UpdateExposureRequest(
                Name: Blank(exposureForm.Name),
                Description: Blank(exposureForm.Description),
                ExposureStart: started,
                ExposureEnd: ended,
                ExposurePlaceId: null));

            if (detached.Value is null)
            {
                entryFailure = detached.Failure;

                return;
            }

            if (await Api.DeletePlace(placeId) is { } whyNot)
            {
                entryFailure = whyNot;

                return;
            }

            editingPlaceId = null;
            placeForm = new PlaceForm();
        }
        finally
        {
            recording = false;
        }
    }

    /// <summary>
    /// Asks the operator to confirm a removal before it is sent, so a delete is
    /// never one click away. True only where they chose to go ahead.
    /// </summary>
    private async Task<bool> Confirm(string title, string message) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: "Delete", cancelText: "Cancel") == true;

    /// <summary>
    /// The place as the boxes hold it, or null where every box is empty: an
    /// exposure with no place sends none rather than an empty row.
    /// </summary>
    private ExposurePlaceRequest? BuiltPlace()
    {
        var place = new ExposurePlaceRequest(
            ExposurePlaceTypeId: placeForm.ExposurePlaceTypeId,
            Name: Blank(placeForm.Name),
            Street: Blank(placeForm.Street),
            City: Blank(placeForm.City),
            Zip: Blank(placeForm.Zip),
            State: Blank(placeForm.State),
            Latitude: placeForm.Latitude,
            Longitude: placeForm.Longitude,
            Phone: Blank(placeForm.Phone));

        return place == new ExposurePlaceRequest() ? null : place;
    }

    /// <summary>Empties the entry form after an exposure is recorded.</summary>
    private void Clear()
    {
        exposureForm = new ExposureForm();
        placeForm = new PlaceForm();
        contacts = [];
        sources = [];
    }

    /// <summary>
    /// The place as the list shows it: its name, or its street and city where
    /// it has no name, or a dash where the exposure has no place.
    /// </summary>
    private static string Placed(ExposurePlaceResponse? place)
    {
        if (place is null)
        {
            return "—";
        }

        if (!string.IsNullOrWhiteSpace(place.Name))
        {
            return place.Name;
        }

        var address = string.Join(", ", new[] { place.Street, place.City }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

        return string.IsNullOrWhiteSpace(address) ? $"place {place.Id}" : address;
    }

    /// <summary>A value as the list shows it, or a dash for what nobody has recorded.</summary>
    private static string Shown(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>An identifier as the list shows it, or a dash where none is recorded.</summary>
    private static string Shown(int? value) =>
        value is { } id ? id.ToString(CultureInfo.InvariantCulture) : "—";

    /// <summary>A coded box's content, trimmed, or null where it holds nothing.</summary>
    private static string? Blank(string? typed) =>
        string.IsNullOrWhiteSpace(typed) ? null : typed.Trim();

    /// <summary>
    /// A date box read: empty is no date, a date is the date, and anything
    /// else is a complaint naming the box — the same rule the other tabs read
    /// their date boxes by.
    /// </summary>
    private static bool TryDate(string? typed, string named, out DateOnly? date, out string? why)
    {
        date = null;
        why = null;

        if (string.IsNullOrWhiteSpace(typed))
        {
            return true;
        }

        if (DateOnly.TryParseExact(typed.Trim(), DateForm, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var parsed))
        {
            date = parsed;

            return true;
        }

        why = $"Give {named} as yyyy-mm-dd, or leave it empty.";

        return false;
    }

    /// <summary>A date as a date box holds it.</summary>
    private static string? Written(DateOnly? date) =>
        date?.ToString(DateForm, CultureInfo.InvariantCulture);

