@* Ad-hoc reports: case counts grouped by one dimension the user picks, over
   an optional event onset range, as the case-counts endpoint returns them.
   Reached only by holders of run_reports, which the API tier enforces
   whatever the navigation shows.

   Every element a later walkthrough will name carries an identifier of its
   own — `reports-heading`, `reports-group-by`, `reports-onset-from`,
   `reports-onset-to`, `reports-run`, `reports-loading`, `reports-error`,
   `reports-none` and the table. A test selects by those and not by a
   MudBlazor class or a cell's position.

   Below it, the same counting over one of the user's saved views, by any one
   of the view's columns: `reports-view`, `reports-view-group-by`,
   `reports-view-run`, `reports-view-export`, `reports-view-error`,
   `reports-view-none` and `reports-view-table`. *@
@page "/reports"
@using System.Globalization
@inject ReportsClient Client
@inject SavedViewsClient SavedViews

<PageTitle>Reports — Survsys</PageTitle>

<MudText id="reports-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Reports
</MudText>

<MudText Typo="Typo.body2" Class="mb-4">
    Count case morbidity reports by one grouping, optionally over a range of
    event onset dates.
</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="groupBy" id="reports-group-by" Label="Group by"
                   Variant="Variant.Outlined">
            @foreach (var grouping in ReportGroupings.All)
            {
                <MudSelectItem T="string" Value="@grouping">@grouping</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        @* Native date inputs, as the saved-view screen's are: what they yield
           is what this screen parses. *@
        <MudTextField @bind-Value="onsetFrom" id="reports-onset-from" Label="Onset from"
                      Variant="Variant.Outlined" InputType="InputType.Date" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="onsetTo" id="reports-onset-to" Label="Onset to"
                      Variant="Variant.Outlined" InputType="InputType.Date" />
    </MudItem>
    <MudItem xs="12">
        <MudButton id="reports-run" Variant="Variant.Filled" Color="Color.Primary" OnClick="@Run">
            Run
        </MudButton>
    </MudItem>
</MudGrid>

@if (running)
{
    <MudProgressCircular id="reports-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (failure is not null)
{
    @* The tier's contract: an API failure is a message on the screen, never
       an unhandled exception in a circuit. *@
    <MudAlert id="reports-error" Severity="Severity.Error" Variant="Variant.Filled">
        @failure
    </MudAlert>
}
else if (counts is not null)
{
    @if (counts.Count == 0)
    {
        <MudText id="reports-none" Typo="Typo.body2">
            No case morbidity reports match.
        </MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudSimpleTable id="reports-table" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>@ranBy</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in counts)
                    {
                        <tr>
                            <td data-report-group>@(row.Group ?? "(none)")</td>
                            <td data-report-count>@row.Count</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

<MudText id="reports-view-heading" HtmlTag="h2" Typo="Typo.h5" Class="mt-8" GutterBottom="true">
    Saved view report
</MudText>

<MudText Typo="Typo.body2" Class="mb-4">
    Count the case morbidity reports one of your saved views selects, by any
    one of the view's columns.
</MudText>

@if (viewsFailure is not null)
{
    <MudAlert id="reports-view-error" Severity="Severity.Error" Variant="Variant.Filled">
        @viewsFailure
    </MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            @* One item per view, labelled by its unique name, so the combobox
               reads as its label. *@
            <MudSelect T="int?" Value="@viewId" ValueChanged="@ChooseView" id="reports-view"
                       Label="Saved view" Variant="Variant.Outlined">
                @foreach (var view in views)
                {
                    <MudSelectItem T="int?" Value="@view.Id">@view.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="viewGroupBy" id="reports-view-group-by" Label="Group by"
                       Variant="Variant.Outlined" Disabled="@(Chosen is null)">
                @foreach (var column in Chosen?.Columns ?? [])
                {
                    <MudSelectItem T="string" Value="@column">@column</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12">
            <MudStack Row="true" Spacing="2">
                <MudButton id="reports-view-run" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(Chosen is null || viewGroupBy is null)" OnClick="@RunView">
                    Run
                </MudButton>
                @if (viewCounts is not null)
                {
                    <MudButton id="reports-view-export" Variant="Variant.Outlined" Color="Color.Primary"
                               Href="@($"/reports/saved-views/{viewRanId}/counts/export?groupBy={Uri.EscapeDataString(viewRanBy)}")"
                               Target="_blank">
                        Export CSV
                    </MudButton>
                }
            </MudStack>
        </MudItem>
    </MudGrid>

    @if (viewFailure is not null)
    {
        <MudAlert id="reports-view-error" Severity="Severity.Error" Variant="Variant.Filled">
            @viewFailure
        </MudAlert>
    }
    else if (viewCounts is not null)
    {
        @if (viewCounts.Count == 0)
        {
            <MudText id="reports-view-none" Typo="Typo.body2">
                The view selects no case morbidity reports.
            </MudText>
        }
        else
        {
            <MudPaper Elevation="1">
                <MudSimpleTable id="reports-view-table" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th>@viewRanBy</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in viewCounts)
                        {
                            <tr>
                                <td data-report-view-group>@(row.Group ?? "(none)")</td>
                                <td data-report-view-count>@row.Count</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    }
}

@code {
    private string groupBy = ReportGroupings.Condition;

    private string? onsetFrom;

    private string? onsetTo;

    private bool running;

    private string? failure;

    private string ranBy = ReportGroupings.Condition;

    private IReadOnlyList<CaseCountResponse>? counts;

    private IReadOnlyList<SavedViewResponse> views = [];

    private string? viewsFailure;

    private int? viewId;

    private string? viewGroupBy;

    private string? viewFailure;

    private int viewRanId;

    private string viewRanBy = "";

    private IReadOnlyList<CaseCountResponse>? viewCounts;

    private SavedViewResponse? Chosen => views.FirstOrDefault(view => view.Id == viewId);

    protected override async Task OnInitializedAsync()
    {
        var listed = await SavedViews.All();
        views = listed.Value?.Items ?? [];
        viewsFailure = listed.Failure;
    }

    /// <summary>Chooses a view, grouping by its first column until another is picked.</summary>
    private void ChooseView(int? id)
    {
        viewId = id;
        viewGroupBy = Chosen?.Columns.FirstOrDefault();
        viewCounts = null;
        viewFailure = null;
    }

    private async Task RunView()
    {
        if (Chosen is not { } view || viewGroupBy is not { } column)
        {
            return;
        }

        var asked = await Client.SavedViewCounts(view.Id, column);

        viewRanId = view.Id;
        viewRanBy = column;
        viewCounts = asked.Value;
        viewFailure = asked.Failure;
    }

    private async Task Run()
    {
        if (!TryDate(onsetFrom, out var from) || !TryDate(onsetTo, out var to))
        {
            failure = "Give the onset dates as yyyy-mm-dd, or leave them empty.";
            counts = null;
            return;
        }

        running = true;
        failure = null;

        var asked = await Client.CaseCounts(groupBy, from, to);

        running = false;
        ranBy = groupBy;
        counts = asked.Value;
        failure = asked.Failure;
    }

    /// <summary>An empty box as no date, or the date it holds; false where it holds something else.</summary>
    private static bool TryDate(string? text, out DateOnly? date)
    {
        date = null;

        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        if (DateOnly.TryParse(text, CultureInfo.InvariantCulture, out var parsed))
        {
            date = parsed;
            return true;
        }

        return false;
    }
}
