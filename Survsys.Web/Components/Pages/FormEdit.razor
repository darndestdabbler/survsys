@* A supplemental form's builder: its core fields, and the nested tree of
   sections, their questions and each coded question's options, built up with
   add, remove and reorder controls. Saving sends the whole tree in one POST
   for a new form or PUT for an existing one and returns to the forms list, as
   the outbreak screen's core Save does. *@
@page "/forms/new"
@page "/forms/{Id:int}"
@inject FormsClient Client
@inject ConditionsClient Conditions
@inject NavigationManager Navigation

<PageTitle>@Heading — Survsys</PageTitle>

<MudText id="form-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    @Heading
</MudText>

@if (loading)
{
    <MudProgressCircular id="form-loading" Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (failure is { } whyNot)
    {
        <MudAlert id="form-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @whyNot
        </MudAlert>
    }

    <MudPaper id="form-core" Elevation="1" Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="name" id="form-name" Label="Name"
                              Variant="Variant.Outlined" Required="true" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="conditionId" id="form-condition" Label="Condition"
                           Variant="Variant.Outlined">
                    @foreach (var condition in conditions)
                    {
                        <MudSelectItem T="int?" Value="@condition.Id">@condition.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudCheckBox T="bool" @bind-Value="autoAssign" id="form-auto-assign"
                             Label="Auto-assign" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="description" id="form-description" Label="Description"
                              Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper id="form-sections" Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Sections</MudText>

        @if (sections.Count == 0)
        {
            <MudText id="form-sections-empty" Typo="Typo.body2" Class="mb-2">
                No sections yet. Add one to begin.
            </MudText>
        }

        @for (var si = 0; si < sections.Count; si++)
        {
            var sectionIndex = si;
            var section = sections[sectionIndex];

            <MudPaper Outlined="true" Class="pa-3 mb-3" data-section="@sectionIndex">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="section.Title"
                                      id="@($"form-section-{sectionIndex}-title")" Label="Section title"
                                      Variant="Variant.Outlined" Required="true" MaxLength="200" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center gap-1">
                        <MudButton id="@($"form-section-{sectionIndex}-up")" Variant="Variant.Outlined"
                                   Size="Size.Small" OnClick="@(() => MoveSection(sectionIndex, -1))">
                            Up
                        </MudButton>
                        <MudButton id="@($"form-section-{sectionIndex}-down")" Variant="Variant.Outlined"
                                   Size="Size.Small" OnClick="@(() => MoveSection(sectionIndex, 1))">
                            Down
                        </MudButton>
                        <MudButton id="@($"form-section-{sectionIndex}-remove")" Variant="Variant.Outlined"
                                   Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => RemoveSection(sectionIndex))">
                            Remove section
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Questions</MudText>

                @if (section.Questions.Count == 0)
                {
                    <MudText id="@($"form-section-{sectionIndex}-questions-empty")" Typo="Typo.body2">
                        No questions yet.
                    </MudText>
                }

                @for (var qi = 0; qi < section.Questions.Count; qi++)
                {
                    var questionIndex = qi;
                    var question = section.Questions[questionIndex];

                    <MudPaper Outlined="true" Class="pa-2 mb-2"
                              data-question="@($"{sectionIndex}-{questionIndex}")">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="question.Text"
                                              id="@($"form-section-{sectionIndex}-question-{questionIndex}-text")"
                                              Label="Question" Variant="Variant.Outlined" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudSelect T="int" @bind-Value="question.AnswerType"
                                           id="@($"form-section-{sectionIndex}-question-{questionIndex}-type")"
                                           Label="Answer type" Variant="Variant.Outlined">
                                    <MudSelectItem T="int" Value="@TextType">Text</MudSelectItem>
                                    <MudSelectItem T="int" Value="@CodedType">Coded</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" Class="d-flex align-center">
                                <MudCheckBox T="bool" @bind-Value="question.IsRequired"
                                             id="@($"form-section-{sectionIndex}-question-{questionIndex}-required")"
                                             Label="Required" />
                            </MudItem>
                            <MudItem xs="12" sm="9">
                                <MudTextField @bind-Value="question.HelpText"
                                              id="@($"form-section-{sectionIndex}-question-{questionIndex}-help")"
                                              Label="Help text" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="3" Class="d-flex align-center gap-1">
                                <MudButton id="@($"form-section-{sectionIndex}-question-{questionIndex}-up")"
                                           Variant="Variant.Outlined" Size="Size.Small"
                                           OnClick="@(() => MoveQuestion(section, questionIndex, -1))">
                                    Up
                                </MudButton>
                                <MudButton id="@($"form-section-{sectionIndex}-question-{questionIndex}-down")"
                                           Variant="Variant.Outlined" Size="Size.Small"
                                           OnClick="@(() => MoveQuestion(section, questionIndex, 1))">
                                    Down
                                </MudButton>
                                <MudButton id="@($"form-section-{sectionIndex}-question-{questionIndex}-remove")"
                                           Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveQuestion(section, questionIndex))">
                                    Remove
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (question.AnswerType == CodedType)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2">Choices</MudText>

                            @for (var oi = 0; oi < question.Options.Count; oi++)
                            {
                                var optionIndex = oi;
                                var option = question.Options[optionIndex];
                                var key = $"form-section-{sectionIndex}-question-{questionIndex}-option-{optionIndex}";

                                <MudGrid Spacing="2" data-option="@key">
                                    <MudItem xs="5" sm="3">
                                        <MudTextField @bind-Value="option.Code" id="@($"{key}-code")"
                                                      Label="Code" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" MaxLength="50" />
                                    </MudItem>
                                    <MudItem xs="5" sm="6">
                                        <MudTextField @bind-Value="option.Label" id="@($"{key}-label")"
                                                      Label="Label" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" MaxLength="200" />
                                    </MudItem>
                                    <MudItem xs="2" sm="3" Class="d-flex align-center">
                                        <MudButton id="@($"{key}-remove")" Variant="Variant.Outlined"
                                                   Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => question.Options.RemoveAt(optionIndex))">
                                            Remove
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudButton id="@($"form-section-{sectionIndex}-question-{questionIndex}-add-option")"
                                       Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       Class="mt-1" OnClick="@(() => question.Options.Add(new OptionEdit()))">
                                Add choice
                            </MudButton>
                        }
                    </MudPaper>
                }

                <MudButton id="@($"form-section-{sectionIndex}-add-question")" Variant="Variant.Text"
                           Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => section.Questions.Add(new QuestionEdit()))">
                    Add question
                </MudButton>
            </MudPaper>
        }

        <MudButton id="form-add-section" Variant="Variant.Outlined" Color="Color.Primary"
                   OnClick="@(() => sections.Add(new SectionEdit()))">
            Add section
        </MudButton>
    </MudPaper>

    <div class="d-flex gap-2">
        <MudButton id="form-save" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@saving" OnClick="@Save">
            Save
        </MudButton>
        <MudButton id="form-cancel" Variant="Variant.Outlined" Disabled="@saving" Href="/forms">
            Cancel
        </MudButton>
    </div>
}

@code {
    /// <summary>The form being edited, or null for a new one.</summary>
    [Parameter]
    public int? Id { get; set; }

    private const int TextType = 0;

    private const int CodedType = 1;

    private string? name;

    private string? description;

    private int? conditionId;

    private bool autoAssign;

    private readonly List<SectionEdit> sections = [];

    private bool loading = true;

    private bool saving;

    private string? failure;

    private IReadOnlyList<ConditionResponse> conditions = [];

    private string Heading => Id is null ? "New form" : "Edit form";

    protected override async Task OnInitializedAsync()
    {
        if ((await Conditions.Page(1, 200)).Value is { } loadedConditions)
        {
            conditions = loadedConditions.Items;
        }

        if (Id is { } id)
        {
            var found = await Client.Find(id);

            if (found.Value is { } form)
            {
                name = form.Name;
                description = form.Description;
                conditionId = form.ConditionId;
                autoAssign = form.AutoAssign;

                foreach (var section in form.Sections)
                {
                    var sectionEdit = new SectionEdit { Title = section.Title };

                    foreach (var question in section.Questions)
                    {
                        var questionEdit = new QuestionEdit
                        {
                            Text = question.Text,
                            HelpText = question.HelpText,
                            IsRequired = question.IsRequired,
                            AnswerType = question.AnswerType,
                        };

                        foreach (var option in question.Options)
                        {
                            questionEdit.Options.Add(new OptionEdit
                            {
                                Code = option.Code,
                                Label = option.Label,
                            });
                        }

                        sectionEdit.Questions.Add(questionEdit);
                    }

                    sections.Add(sectionEdit);
                }
            }

            failure = found.Failure;
        }

        loading = false;
    }

    private async Task Save()
    {
        saving = true;
        failure = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            failure = "Give the form a name.";
            saving = false;

            return;
        }

        if (conditionId is not { } condition)
        {
            failure = "Choose the condition this form is for.";
            saving = false;

            return;
        }

        var request = new SaveFormRequest(
            name,
            condition,
            autoAssign,
            Blank(description),
            sections.Select(ToSection).ToList());

        var saved = Id is { } id
            ? await Client.Update(id, request)
            : await Client.Create(request);

        saving = false;

        if (saved.Succeeded)
        {
            Navigation.NavigateTo("/forms");

            return;
        }

        failure = saved.Failure;
    }

    private static SaveFormSectionRequest ToSection(SectionEdit section) =>
        new(section.Title ?? "", section.Questions.Select(ToQuestion).ToList());

    private static SaveFormQuestionRequest ToQuestion(QuestionEdit question) =>
        new(
            question.Text ?? "",
            question.AnswerType,
            question.IsRequired,
            Blank(question.HelpText),
            question.AnswerType == CodedType
                ? question.Options
                    .Select(option => new SaveFormQuestionOptionRequest(option.Code ?? "", option.Label ?? ""))
                    .ToList()
                : null);

    private void MoveSection(int index, int delta) => Move(sections, index, delta);

    private void RemoveSection(int index) => sections.RemoveAt(index);

    private static void MoveQuestion(SectionEdit section, int index, int delta) =>
        Move(section.Questions, index, delta);

    private static void RemoveQuestion(SectionEdit section, int index) =>
        section.Questions.RemoveAt(index);

    private static void Move<T>(List<T> items, int index, int delta)
    {
        var target = index + delta;

        if (target < 0 || target >= items.Count)
        {
            return;
        }

        (items[index], items[target]) = (items[target], items[index]);
    }

    private static string? Blank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class SectionEdit
    {
        public string? Title { get; set; }

        public List<QuestionEdit> Questions { get; } = [];
    }

    private sealed class QuestionEdit
    {
        public string? Text { get; set; }

        public string? HelpText { get; set; }

        public bool IsRequired { get; set; }

        public int AnswerType { get; set; }

        public List<OptionEdit> Options { get; } = [];
    }

    private sealed class OptionEdit
    {
        public string? Code { get; set; }

        public string? Label { get; set; }
    }
}
