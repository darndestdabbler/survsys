@* The case morbidity report's own form: where the legacy creation flow ends,
   and where every tab of the report lives.

   ../nedss/docs/functional/epitrax-cmr-workflow.md records the form at
   /event/edit/{recordNumber} as a header bar that stays above every tab and
   a strip of eight tabs. This is that form, reduced to what this release
   holds. The address is by the report's identifier, because
   GET /api/person-conditions/{id} is the endpoint that reads a report back
   and nothing finds one by its record number yet; the record number is in
   the header, where the legacy form shows it.

   The header shows only what the report carries -- the patient, the record
   number, the event type, the disease, the investigating agency and the
   event date -- and none of the legacy header's actions or workflow fields,
   because the columns behind those are not on the report and a blank for
   each would be promising a feature. The strip carries the Demographic tab
   alone: the other seven arrive with the sessions that own them.

   The person's name and the condition's are read from their own resources,
   since the report carries identifiers and not names; the disease and the
   agency come from the same two lists the creation screen offers, which is
   one ask each. The first ask that fails is the one reported, in the words
   of the client that made it. *@
@page "/event/edit/{ReportId:int}"
@inject PersonConditionsClient Reports
@inject PersonsClient Persons
@inject ConditionsClient Conditions
@inject AgenciesClient Agencies
@inject ClinicalClient Clinical
@inject InvestigationClient Investigation
@inject AdministrativeClient Administrative
@inject CoreElementsClient CoreElements
@inject NotificationQueueClient Notifications
@inject UsersClient Users

<PageTitle>@Title — Survsys</PageTitle>

<MudText id="report-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Case morbidity report
</MudText>

@if (loading)
{
    <MudProgressCircular id="report-busy" Color="Color.Primary" Indeterminate="true" />
}
else if (failure is { } whyNot)
{
    <MudAlert id="report-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        @whyNot
    </MudAlert>
}
else if (report is { } shown && person is not null && clinical is { } clinicalData
         && investigation is { } investigationData && administrative is { } administrativeData)
{
    @* The header bar: a label and a value per field, each value with the
       identifier a walkthrough names it by. *@
    <MudPaper id="report-header" Elevation="1" Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Patient name</MudText>
                <MudText id="report-header-patient" Typo="Typo.body1">@Named</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Record #</MudText>
                <MudText id="report-header-record-number" Typo="Typo.body1">@shown.RecordNumber</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Event type</MudText>
                <MudText id="report-header-event-type" Typo="Typo.body1">@EventType</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Disease</MudText>
                <MudText id="report-header-disease" Typo="Typo.body1">@Disease</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Investigating agency</MudText>
                <MudText id="report-header-agency" Typo="Typo.body1">@Agency</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Event date</MudText>
                <MudText id="report-header-event-date" Typo="Typo.body1">@EventDate</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">MMWR week</MudText>
                <MudText id="report-header-mmwr" Typo="Typo.body1">@Mmwr</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Case status</MudText>
                <MudText id="report-header-case-status" Typo="Typo.body1">@Status</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">Investigator</MudText>
                <MudText id="report-header-investigator" Typo="Typo.body1">@(InvestigatorName ?? "Not assigned")</MudText>
            </MudItem>
            @* The two per-jurisdiction statuses are shown as the identifiers the
               Administrative tab stores until their code list exists. *@
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">State case status</MudText>
                <MudText id="report-header-state-case-status" Typo="Typo.body1">@shown.StateCaseStatusId</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption">LHD case status</MudText>
                <MudText id="report-header-lhd-case-status" Typo="Typo.body1">@shown.LhdCaseStatusId</MudText>
            </MudItem>
        </MudGrid>

        @* The brief note: a line kept at the top of the case, saved on its
           own, as the legacy header's text box and Save button are. *@
        <MudGrid Spacing="2" Class="align-center mt-2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="briefNote" id="report-header-brief-note" Label="Brief note"
                              Variant="Variant.Outlined" MaxLength="500" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudButton id="report-header-brief-note-save" Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="@savingBriefNote" OnClick="@SaveBriefNote">
                    Save note
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (briefNoteError is { } whyNotNoted)
        {
            <MudAlert id="report-header-brief-note-error" Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mt-2">
                @whyNotNoted
            </MudAlert>
        }

        @* A contact event is promoted to a morbidity report when the contact
           turns out to have the condition; the API tier refuses it on any
           other case, so the button is offered on a contact event alone. *@
        @if (promoteError is { } whyNotPromoted)
        {
            <MudAlert id="report-promote-error" Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mt-4">
                @whyNotPromoted
            </MudAlert>
        }

        @if (promoted is { } promotedMessage)
        {
            <MudAlert id="report-promoted" Severity="Severity.Success" Variant="Variant.Filled"
                      Class="mt-4">
                @promotedMessage
            </MudAlert>
        }

        @if (shown.EventType == "contact")
        {
            <MudButton id="report-promote" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       Disabled="@promoting" OnClick="@Promote">
                Promote to morbidity report
            </MudButton>
        }
    </MudPaper>

    @* The case status editor: a text box holding the legacy code, as every
       coded field in this tier is, and the API tier's to validate — a code it
       refuses is shown here rather than re-checked. The status is a case-level
       field, so it sits above the tab strip and not inside a tab. *@
    <MudPaper id="report-status" Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Case status</MudText>

        @if (statusSaved is { } savedMessage)
        {
            <MudAlert id="report-status-saved" Severity="Severity.Success" Variant="Variant.Filled"
                      Class="mb-4">
                @savedMessage
            </MudAlert>
        }

        @if (statusError is { } whyNotSaved)
        {
            <MudAlert id="report-status-error" Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mb-4">
                @whyNotSaved
            </MudAlert>
        }

        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="statusCode" id="report-status-input"
                              Label="Case status (C/P/S/NC)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudButton id="report-status-save" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@savingStatus" OnClick="@SaveStatus">
                    Save status
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* The legacy Workflow Options: the report's state, its investigator, and
       one button per move the API tier lists for this user on this case. The
       list is already narrowed by the case's state and the user's privileges,
       so the panel holds no rule of its own; a move the API still refuses is
       shown as the client's message. The agency and investigator pickers show
       only while the move that takes them is offered. *@
    <MudPaper id="report-workflow" Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Workflow Options</MudText>

        @if (workflowSaved is { } movedMessage)
        {
            <MudAlert id="report-workflow-saved" Severity="Severity.Success" Variant="Variant.Filled"
                      Class="mb-4">
                @movedMessage
            </MudAlert>
        }

        @if (workflowError is { } whyNotMoved)
        {
            <MudAlert id="report-workflow-error" Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mb-4">
                @whyNotMoved
            </MudAlert>
        }

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption">Workflow status</MudText>
                <MudText id="report-workflow-state" Typo="Typo.body1">@WorkflowLabel(workflow?.WorkflowState)</MudText>
            </MudItem>
            @if (InvestigatorName is { } investigatorName)
            {
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">Investigator</MudText>
                    <MudText id="report-workflow-investigator" Typo="Typo.body1">@investigatorName</MudText>
                </MudItem>
            }
        </MudGrid>

        @if (workflow?.Options.Count > 0)
        {
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="workflowNote" id="report-workflow-note"
                                  Label="Note" Variant="Variant.Outlined" />
                </MudItem>
                @if (Offers("route"))
                {
                    <MudItem xs="12" sm="4">
                        <MudSelect T="int?" @bind-Value="routeAgencyId" id="report-workflow-agency"
                                   Label="Route to agency" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var agency in agencies)
                            {
                                <MudSelectItem T="int?" Value="@agency.Id">@agency.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                @if (Offers("assign_investigator"))
                {
                    <MudItem xs="12" sm="4">
                        <MudSelect T="int?" @bind-Value="assignInvestigatorId" id="report-workflow-investigator-id"
                                   Label="Investigator" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var investigator in investigators)
                            {
                                <MudSelectItem T="int?" Value="@investigator.Id">@investigator.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
            @foreach (var code in workflow?.Options ?? [])
            {
                <MudButton id="@($"report-workflow-{code}")" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@moving" OnClick="@(() => Move(code))">
                    @MoveLabel(code)
                </MudButton>
            }
        </MudStack>
    </MudPaper>

    @* The manual CDC-notification action: a case change queues the case for
       notification on its own, and this queues it again by hand, for a case
       that must be re-sent. A case-level action, so it sits above the tab strip
       with the status editor. Each named element carries its own id. *@
    <MudPaper id="report-notify" Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">CDC notification</MudText>

        @if (notifyQueued is { } queuedMessage)
        {
            <MudAlert id="report-notify-queued" Severity="Severity.Success" Variant="Variant.Filled"
                      Class="mb-4">
                @queuedMessage
            </MudAlert>
        }

        @if (notifyError is { } whyNotQueued)
        {
            <MudAlert id="report-notify-error" Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mb-4">
                @whyNotQueued
            </MudAlert>
        }

        <MudText Typo="Typo.body2" Class="mb-2">
            Queue this case to be notified to CDC. A case change queues it
            automatically; this queues it again by hand.
        </MudText>

        <MudButton id="report-notify-queue" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@queuing" OnClick="@QueueForNotification">
            Queue for notification
        </MudButton>
    </MudPaper>

    <MudTabs id="report-tabs" Elevation="1" Rounded="true" ApplyEffectsToContainer="true"
             TabPanelsClass="pa-4">
        @* The tab's own identifier is on what the tab shows rather than on
           the panel: MudTabPanel has an ID parameter of its own, which an id
           attribute would bind to, and clicking the label is clicking the
           tab. *@
        <MudTabPanel Text="Demographic">
            <TabContent>
                <span id="report-tab-demographic">Demographic</span>
            </TabContent>
            <ChildContent>
                <DemographicsTab Person="@person" EventOnsetDate="@shown.EventOnsetDate" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Clinical">
            <TabContent>
                <span id="report-tab-clinical">Clinical</span>
            </TabContent>
            <ChildContent>
                <ClinicalTab ReportId="@shown.Id" Clinical="@clinicalData" Hidden="@hidden" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Laboratory">
            <TabContent>
                <span id="report-tab-laboratory">Laboratory</span>
            </TabContent>
            <ChildContent>
                <LaboratoryTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Investigation">
            <TabContent>
                <span id="report-tab-investigation">Investigation</span>
            </TabContent>
            <ChildContent>
                <InvestigationTab ReportId="@shown.Id" Investigation="@investigationData" Hidden="@hidden" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Administrative">
            <TabContent>
                <span id="report-tab-administrative">Administrative</span>
            </TabContent>
            <ChildContent>
                <AdministrativeTab Report="@shown" Administrative="@administrativeData" Hidden="@hidden"
                                   History="@(workflow?.History ?? [])" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Forms">
            <TabContent>
                <span id="report-tab-forms">Forms</span>
            </TabContent>
            <ChildContent>
                <FormsTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Vaccines">
            <TabContent>
                <span id="report-tab-vaccines">Vaccines</span>
            </TabContent>
            <ChildContent>
                <VaccinesTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Treatments">
            <TabContent>
                <span id="report-tab-treatments">Treatments</span>
            </TabContent>
            <ChildContent>
                <TreatmentsTab ReportId="@shown.Id" ConditionId="@shown.ConditionId" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Encounters">
            <TabContent>
                <span id="report-tab-encounters">Encounters</span>
            </TabContent>
            <ChildContent>
                <EncountersTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Contacts">
            <TabContent>
                <span id="report-tab-contacts">Contacts</span>
            </TabContent>
            <ChildContent>
                <ContactsTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Notes">
            <TabContent>
                <span id="report-tab-notes">Notes</span>
            </TabContent>
            <ChildContent>
                <NotesTab ReportId="@shown.Id" />
            </ChildContent>
        </MudTabPanel>
    </MudTabs>
}

@code {
    /// <summary>The report this form is for, from the address.</summary>
    [Parameter]
    public int ReportId { get; set; }

    private PersonConditionResponse? report;

    private PersonDetailResponse? person;

    private IReadOnlyList<ConditionResponse> diseases = [];

    private IReadOnlyList<AgencyResponse> agencies = [];

    private ClinicalResponse? clinical;

    private InvestigationResponse? investigation;

    private AdministrativeResponse? administrative;

    /// <summary>
    /// The uids of the fields core element configuration hides on this
    /// report, for its condition and investigating agency.
    /// </summary>
    private IReadOnlySet<string> hidden = new HashSet<string>();

    private bool loading = true;

    private string? failure;

    private string? statusCode;

    private string? briefNote;

    private bool savingBriefNote;

    private string? briefNoteError;

    private bool savingStatus;

    private string? statusSaved;

    private string? statusError;

    private bool promoting;

    private string? promoted;

    private string? promoteError;

    private bool queuing;

    private string? notifyQueued;

    private string? notifyError;

    /// <summary>The report's workflow as this user sees it: state, the moves they may make, history.</summary>
    private WorkflowResponse? workflow;

    private IReadOnlyList<InvestigatorResponse> investigators = [];

    private string? workflowNote;

    private int? routeAgencyId;

    private int? assignInvestigatorId;

    private bool moving;

    private string? workflowSaved;

    private string? workflowError;

    /// <summary>
    /// How many conditions this screen asks for: the whole catalogue in one
    /// page, for the reason the creation screen gives.
    /// </summary>
    private const int Catalogue = 200;

    protected override async Task OnInitializedAsync()
    {
        // The report first, because every other ask depends on what it
        // says; a report that could not be read leaves nothing else to ask.
        var found = await Reports.Find(ReportId);

        if (found.Value is not { } shown)
        {
            failure = found.Failure;
            loading = false;

            return;
        }

        report = shown;
        statusCode = shown.CaseStatus;
        briefNote = shown.BriefNote;

        var who = await Persons.Find(shown.PersonId);
        var conditions = await Conditions.Page(1, Catalogue);
        var listed = await Agencies.All();
        var clinicalData = await Clinical.Find(shown.Id);
        var investigationData = await Investigation.Find(shown.Id);
        var administrativeData = await Administrative.Find(shown.Id);
        var hiddenElements = await CoreElements.HiddenOn(shown.Id);
        var workflowData = await Reports.Workflow(shown.Id);
        var investigatorList = await Users.Investigators();

        workflow = workflowData.Value;
        investigators = investigatorList.Value ?? [];
        person = who.Value;
        diseases = conditions.Value?.Items ?? [];
        agencies = listed.Value?.Items ?? [];
        clinical = clinicalData.Value;
        investigation = investigationData.Value;
        administrative = administrativeData.Value;
        hidden = hiddenElements.Value?.ToHashSet() ?? [];

        // The first ask that failed is the one worth reporting.
        failure = who.Failure ?? conditions.Failure ?? listed.Failure ?? clinicalData.Failure
            ?? investigationData.Failure ?? administrativeData.Failure ?? hiddenElements.Failure
            ?? workflowData.Failure ?? investigatorList.Failure;

        loading = false;
    }

    /// <summary>What the browser tab says: the record number, once there is one.</summary>
    private string Title => report is null
        ? "Case morbidity report"
        : $"Case morbidity report {report.RecordNumber}";

    /// <summary>
    /// The person's name as the legacy header bar writes it: last name first.
    /// </summary>
    private string Named => person is null
        ? $"person {report?.PersonId}"
        : string.IsNullOrWhiteSpace(person.FirstName)
            ? person.LastName
            : $"{person.LastName}, {person.FirstName}";

    /// <summary>
    /// The disease by name, or by identifier where the catalogue page did not
    /// carry it.
    /// </summary>
    private string Disease => diseases
        .FirstOrDefault(condition => condition.Id == report?.ConditionId)?.Name
        ?? $"condition {report?.ConditionId}";

    /// <summary>
    /// The agency by name; "(none)" where none was chosen, which the report
    /// allows.
    /// </summary>
    private string Agency => report?.AgencyId is not { } agencyId
        ? "(none)"
        : agencies.FirstOrDefault(agency => agency.Id == agencyId)?.Name
            ?? $"agency {agencyId}";

    /// <summary>
    /// The event type as the legacy header writes it: Morbidity, Contact or
    /// Assessment.
    /// </summary>
    private string EventType => report?.EventType switch
    {
        "contact" => "Contact",
        "assessment" => "Assessment",
        _ => "Morbidity",
    };

    /// <summary>
    /// The event date, written as the date boxes in this tier take one, or
    /// "(not recorded)" where the report has none.
    /// </summary>
    private string EventDate => report?.EventOnsetDate is { } date
        ? date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
        : "(not recorded)";

    /// <summary>
    /// The MMWR week and year together, or "(not calculated)" where the report
    /// has no onset date to count from.
    /// </summary>
    private string Mmwr => report?.MmwrWeek is { } week && report.MmwrYear is { } year
        ? $"Week {week}, {year}"
        : "(not calculated)";

    /// <summary>
    /// The case status code, or "Unknown" where none is set — which is how the
    /// report carries an unclassified case.
    /// </summary>
    private string Status => report?.CaseStatus is { } code && !string.IsNullOrWhiteSpace(code)
        ? code
        : "Unknown";

    /// <summary>
    /// Sets the case status through the API tier and replaces the shown report
    /// with the answer, so the header reads what was stored and not what was
    /// typed; the vocabulary rule is the API's, and a code it refuses is shown
    /// as the failure rather than re-checked here.
    /// </summary>
    private async Task SaveStatus()
    {
        if (report is not { } current)
        {
            return;
        }

        statusSaved = null;
        statusError = null;
        savingStatus = true;

        try
        {
            var answered = await Reports.SetStatus(
                current.Id, new UpdateCaseStatusRequest(Blank(statusCode)));

            if (answered.Value is { } updated)
            {
                report = updated;
                statusCode = updated.CaseStatus;
                statusSaved = "The case status has been saved.";
            }
            else
            {
                statusError = answered.Failure;
            }
        }
        finally
        {
            savingStatus = false;
        }
    }

    /// <summary>
    /// Makes this contact event a morbidity report, and shows the report as
    /// the API tier now holds it or why it was not promoted.
    /// </summary>
    private async Task Promote()
    {
        if (report is not { } current)
        {
            return;
        }

        promoted = null;
        promoteError = null;
        promoting = true;

        try
        {
            var answered = await Reports.Promote(current.Id);

            if (answered.Value is { } updated)
            {
                report = updated;
                promoted = "The contact event is now a morbidity report.";
            }
            else
            {
                promoteError = answered.Failure;
            }
        }
        finally
        {
            promoting = false;
        }
    }

    /// <summary>
    /// Saves the brief note through the API tier and replaces the shown report
    /// with the answer, so the box holds the note as stored.
    /// </summary>
    private async Task SaveBriefNote()
    {
        if (report is not { } current)
        {
            return;
        }

        briefNoteError = null;
        savingBriefNote = true;

        try
        {
            var answered = await Reports.SaveBriefNote(current.Id, Blank(briefNote));

            if (answered.Value is { } updated)
            {
                report = updated;
                briefNote = updated.BriefNote;
            }
            else
            {
                briefNoteError = answered.Failure;
            }
        }
        finally
        {
            savingBriefNote = false;
        }
    }

    /// <summary>The status box's content, trimmed, or null where it holds nothing.</summary>
    private static string? Blank(string? typed) =>
        string.IsNullOrWhiteSpace(typed) ? null : typed.Trim();

    /// <summary>Whether the API tier lists this move for this user on this case.</summary>
    private bool Offers(string code) => workflow?.Options.Contains(code) == true;

    /// <summary>The investigator's name, or null where none is assigned.</summary>
    private string? InvestigatorName => workflow?.InvestigatorId is not { } id
        ? null
        : investigators.FirstOrDefault(investigator => investigator.Id == id)?.DisplayName ?? $"user {id}";

    /// <summary>
    /// A workflow code read as its label. The codes are the legacy codes the
    /// wire carries; the API tier owns them, and this is display only.
    /// </summary>
    internal static string WorkflowLabel(string? workflowState) => workflowState switch
    {
        "assigned_to_lhd" => "Assigned to LHD",
        "accepted" => "Accepted",
        "under_investigation" => "Under investigation",
        "closed" => "Closed",
        "not_investigated" => "Not investigated",
        "approved_by_state" => "Approved by state",
        "rejected_by_state" => "Rejected by state",
        null => "",
        _ => workflowState,
    };

    /// <summary>A transition code read as the words its button shows.</summary>
    internal static string MoveLabel(string code) => code switch
    {
        "accept" => "Accept",
        "investigate" => "Investigate",
        "close" => "Close",
        "route" => "Route to agency",
        "assign_investigator" => "Assign investigator",
        "do_not_investigate" => "Do not investigate",
        "reopen" => "Reopen",
        "approve" => "Approve",
        "reject" => "Reject",
        _ => code,
    };

    /// <summary>
    /// Makes a workflow move through the API tier, then reads the report and
    /// its workflow back, so the header's agency, the state, the options and
    /// the history show what was stored. A route or an assignment with nothing
    /// chosen is refused here, since there is nothing to send; every other
    /// refusal is the API's and is shown as the client's message.
    /// </summary>
    private async Task Move(string code)
    {
        if (report is not { } current)
        {
            return;
        }

        workflowSaved = null;
        workflowError = null;

        if (code == "route" && routeAgencyId is null)
        {
            workflowError = "Choose the agency to route the report to.";

            return;
        }

        if (code == "assign_investigator" && assignInvestigatorId is null)
        {
            workflowError = "Choose the investigator to assign.";

            return;
        }

        moving = true;

        try
        {
            var answered = await Reports.Transition(current.Id, new WorkflowTransitionRequest(
                code,
                Blank(workflowNote),
                code == "route" ? routeAgencyId : null,
                code == "assign_investigator" ? assignInvestigatorId : null));

            if (answered.Value is not { } moved)
            {
                workflowError = answered.Failure;

                return;
            }

            report = moved;

            var reread = await Reports.Workflow(current.Id);
            workflow = reread.Value ?? workflow;
            workflowError = reread.Failure;
            workflowNote = null;
            routeAgencyId = null;
            assignInvestigatorId = null;
            workflowSaved = $"{MoveLabel(code)} was made: the report is now {WorkflowLabel(moved.WorkflowState)}.";
        }
        finally
        {
            moving = false;
        }
    }

    /// <summary>
    /// Queues the case for CDC notification by hand, showing when it was queued
    /// on success or the client's message on failure. The auto-queue already
    /// queues a case on change; this is for a case that must be re-sent.
    /// </summary>
    private async Task QueueForNotification()
    {
        if (report is not { } current)
        {
            return;
        }

        notifyQueued = null;
        notifyError = null;
        queuing = true;

        try
        {
            var answered = await Notifications.Queue(current.Id);

            if (answered.Value is { } row)
            {
                notifyQueued = $"This case was queued for notification at "
                    + $"{row.QueuedAt:yyyy-MM-dd HH:mm}.";
            }
            else
            {
                notifyError = answered.Failure;
            }
        }
        finally
        {
            queuing = false;
        }
    }
}
