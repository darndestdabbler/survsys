@* The treatments, for their management: every treatment ordered by name, each
   name the way into its editor, and New treatment for an empty one. The active
   and default flags and the count of conditions a treatment is listed for are
   shown beside it. Every treatment, with the ids of the conditions it is
   listed for, exports as CSV and imports from it, previewed before it is
   saved: a row with a blank id is added and one with an id saves over that
   treatment, its conditions replaced. *@
@page "/treatments"
@inject TreatmentsClient Client

<PageTitle>Treatments — Survsys</PageTitle>

<MudText id="treatments-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Treatments
</MudText>

<div class="d-flex gap-4 align-start mb-4">
    <MudButton id="treatments-new" Variant="Variant.Filled" Color="Color.Primary" Href="/treatments/new">
        New treatment
    </MudButton>
    <MudButton id="treatments-export" Variant="Variant.Outlined" Href="/treatments/export" Target="_blank">
        Export treatments CSV
    </MudButton>
    <div>
        <ImportPreview Prefix="treatments-import" Label="Import treatments CSV"
                       Import="@((csv, confirm) => Client.Import(csv, confirm))" Imported="@Load" />
    </div>
</div>

@if (asked is null)
{
    <MudProgressCircular id="treatments-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (asked.Value is { } result)
{
    <MudPaper Elevation="1">
        <MudSimpleTable id="treatments-table" Hover="true" Striped="true">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Active</th>
                    <th>Default</th>
                    <th>Conditions</th>
                </tr>
            </thead>
            <tbody>
                @if (result.Items.Count == 0)
                {
                    <tr id="treatments-empty">
                        <td colspan="4">No treatments have been added.</td>
                    </tr>
                }
                @foreach (var treatment in result.Items)
                {
                    <tr data-treatment="@treatment.Id">
                        <td data-treatment-name>
                            <MudLink Href="@($"/treatments/{treatment.Id}")">@treatment.Name</MudLink>
                        </td>
                        <td data-treatment-active>@(treatment.Active ? "Yes" : "No")</td>
                        <td data-treatment-default>@(treatment.DefaultTreatment ? "Yes" : "No")</td>
                        <td data-treatment-conditions>@treatment.ConditionCount</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}
else
{
    <MudAlert id="treatments-error" Severity="Severity.Error" Variant="Variant.Filled">
        @asked.Failure
    </MudAlert>
}

@code {
    private Asked<PagedResult<TreatmentResponse>>? asked;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() =>
        asked = await Client.All();
}
