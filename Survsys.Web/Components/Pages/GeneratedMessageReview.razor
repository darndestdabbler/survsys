@* One CDC export whole: its log summary and the message that was generated
   for it, read through the detail endpoint. A reviewer reads the generated
   message to see what was, or would be, sent to CDC.

   Every element a later walkthrough will name carries an identifier of its
   own — `generated-message-review-heading`, `-back`, `-loading`, `-error`,
   `-record`, `-guide`, `-queued`, `-sent`, `-outcome`, `-message` and
   `-none`. A test selects by those and not by a MudBlazor class or a cell's
   position. *@
@page "/export-log/{Id:int}"
@inject ExportLogClient Client

<PageTitle>Generated message — Survsys</PageTitle>

<MudText id="generated-message-review-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Export @Id
</MudText>

<MudButton id="generated-message-review-back" Variant="Variant.Text" Href="/export-log" Class="mb-4">
    Back to the export log
</MudButton>

@if (asked is null)
{
    <MudProgressCircular id="generated-message-review-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (asked.Value is { } detail)
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudSimpleTable Dense="true" Bordered="false" Striped="false">
            <tbody>
                <tr>
                    <th scope="row">Record number</th>
                    <td id="generated-message-review-record">@detail.Entry.RecordNumber</td>
                </tr>
                <tr>
                    <th scope="row">Guide</th>
                    <td id="generated-message-review-guide">
                        @(detail.Entry.GuideId is { } guide ? guide.ToString() : "—")
                    </td>
                </tr>
                <tr>
                    <th scope="row">Queued</th>
                    <td id="generated-message-review-queued">@detail.Entry.QueuedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                <tr>
                    <th scope="row">Sent</th>
                    <td id="generated-message-review-sent">
                        @(detail.Entry.SentAt is { } sent ? sent.ToString("yyyy-MM-dd HH:mm") : "—")
                    </td>
                </tr>
                <tr>
                    <th scope="row">Outcome</th>
                    <td id="generated-message-review-outcome">
                        @(string.IsNullOrWhiteSpace(detail.Entry.Outcome) ? "—" : detail.Entry.Outcome)
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudText Typo="Typo.h6" GutterBottom="true">Generated message</MudText>
    @if (string.IsNullOrEmpty(detail.GeneratedMessage))
    {
        @* An export logged before a message was generated for it: the row is
           real and the message is not there yet, which is a line to read rather
           than an empty block. *@
        <MudText id="generated-message-review-none" Typo="Typo.body2">
            No message has been generated for this export yet.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            The message that was, or would be, sent to CDC for this export.
        </MudText>
        <MudPaper Elevation="1" Class="pa-4">
            <pre id="generated-message-review-message" style="white-space: pre-wrap; word-break: break-word; margin: 0;">@detail.GeneratedMessage</pre>
        </MudPaper>
    }
}
else
{
    @* The tier's contract: an API failure is a message on the screen, never
       an unhandled exception in a circuit. ExportLogClient hands over the
       message; this is where it is shown — an export that is not there reads
       as the client's not-found sentence. *@
    <MudAlert id="generated-message-review-error" Severity="Severity.Error" Variant="Variant.Filled">
        @asked.Failure
    </MudAlert>
}

@code {
    /// <summary>The export this screen reads, by its log identifier.</summary>
    [Parameter]
    public int Id { get; set; }

    private Asked<CdcExportLogDetailResponse>? asked;

    protected override async Task OnParametersSetAsync()
    {
        asked = null;
        asked = await Client.Find(Id);
    }
}
