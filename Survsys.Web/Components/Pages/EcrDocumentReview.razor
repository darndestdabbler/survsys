@* One eCR document with its pair: the eICR as the HL7 CDA stylesheet renders
   it, beside the RR's conditions with their determinations and responsible
   agencies and the cases the eICR was written to, or why it is held for
   review, and below them what validation found in each document. An eICR
   can have more than one RR, so each finding names its document by kind and
   id.

   The rendering is the document's own text, so it is shown in an iframe with
   an empty sandbox: no scripts, no forms, no navigation of this page.

   Every element a later walkthrough will name carries an identifier of its
   own — `ecr-document-heading`, `-back`, `-loading`, `-error`, `-eicr`,
   `-no-eicr`, `-conditions`, `-no-conditions`, `-cases`, `-case-{id}`,
   `-case-review`, `-no-cases`, `-findings` and `-no-findings`.

   An eICR held for review is settled here by a user holding edit_cases: each
   person its patient may be is listed (`ecr-document-match-{n}`, with
   `-name` and `-use`) with Use this person, beside Create new person
   (`ecr-document-create-person`); either writes the eICR to that person's
   cases and the list of cases replaces the hold, or the failure is shown
   (`ecr-document-settle-error`). *@
@page "/ecr/{Id:int}"
@inject EcrClient Client

<PageTitle>eCR document — Survsys</PageTitle>

<MudText id="ecr-document-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    @(asked?.Value is { } loaded ? $"{loaded.Document.Kind} {loaded.Document.DocumentId}" : $"eCR document {Id}")
</MudText>

<MudButton id="ecr-document-back" Variant="Variant.Text" Href="/ecr" Class="mb-4">
    Back to the queue
</MudButton>

@if (asked is null)
{
    <MudProgressCircular id="ecr-document-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (asked.Value is { } detail)
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudText HtmlTag="h2" Typo="Typo.h6" GutterBottom="true">eICR</MudText>
            @if (detail.EicrHtml is null)
            {
                <MudText id="ecr-document-no-eicr" Typo="Typo.body2">
                    The eICR this response is for has not been received.
                </MudText>
            }
            else
            {
                <iframe id="ecr-document-eicr" title="The eICR" sandbox="" srcdoc="@detail.EicrHtml"
                        style="width: 100%; height: 80vh; border: 1px solid var(--mud-palette-lines-default);"></iframe>
            }
        </MudItem>
        <MudItem xs="12" md="5">
            <MudText HtmlTag="h2" Typo="Typo.h6" GutterBottom="true">Reportability response</MudText>
            @if (detail.Conditions.Count == 0)
            {
                <MudText id="ecr-document-no-conditions" Typo="Typo.body2">
                    No reportability response with conditions has been received for this eICR.
                </MudText>
            }
            else
            {
                <MudPaper Elevation="1">
                    <MudSimpleTable id="ecr-document-conditions" Dense="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Condition</th>
                                <th>Determination</th>
                                <th>Responsible agency</th>
                                <th>Report within</th>
                                <th>Maps to</th>
                                <th>Routing</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var condition in detail.Conditions)
                            {
                                <tr data-ecr-condition="@condition.ConditionCode">
                                    <td>@Shown(condition.ConditionName, condition.ConditionCode)</td>
                                    <td>
                                        @Shown(condition.DeterminationName, condition.DeterminationCode)
                                        @if (condition.LocationCode is not null)
                                        {
                                            <br /><MudText Typo="Typo.caption">@Shown(condition.LocationName, condition.LocationCode)</MudText>
                                        }
                                    </td>
                                    <td>@Shown(condition.ResponsibleAgencyName, condition.ResponsibleAgencyId)</td>
                                    <td>@(condition.ReportingTimeframe ?? "—")</td>
                                    <td data-ecr-mapped>@(condition.MappedConditionName ?? "—")</td>
                                    <td data-ecr-routing>
                                        @switch (condition.Routing)
                                        {
                                            case "reportable":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Reportable</MudChip>
                                                break;
                                            case "review":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Needs review</MudChip>
                                                break;
                                            default:
                                                <span>Not kept</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }

            <MudText HtmlTag="h2" Typo="Typo.h6" Class="mt-6" GutterBottom="true">Cases</MudText>
            @if (detail.CaseStatus == "linked" && detail.CaseIds is { Count: > 0 } caseIds)
            {
                <div id="ecr-document-cases" class="d-flex flex-column gap-1">
                    <MudText Typo="Typo.body2">The eICR was written to these cases:</MudText>
                    @foreach (var caseId in caseIds)
                    {
                        <MudLink id="@($"ecr-document-case-{caseId}")" Href="@($"/event/edit/{caseId}")">
                            Open case
                        </MudLink>
                    }
                </div>
            }
            else if (detail.CaseStatus == "review")
            {
                <MudAlert id="ecr-document-case-review" Severity="Severity.Warning" Dense="true">
                    Held for review: @detail.CaseReason
                </MudAlert>

                @if (settleFailure is { } whyNotSettled)
                {
                    <MudAlert id="ecr-document-settle-error" Severity="Severity.Error" Class="mt-2">
                        @whyNotSettled
                    </MudAlert>
                }

                @if (mayEditCases)
                {
                    <div class="d-flex flex-column gap-2 mt-2">
                        @if (matches?.Value is { } proposal)
                        {
                            var proposed = proposal.Candidates
                                .Where(candidate => candidate.Verdict != PersonMatchCandidateResponse.None)
                                .ToList();
                            for (var m = 0; m < proposed.Count; m++)
                            {
                                var candidate = proposed[m];
                                <div id="@($"ecr-document-match-{m}")" class="d-flex align-center gap-2">
                                    <MudText id="@($"ecr-document-match-{m}-name")" Typo="Typo.body2">
                                        <strong>@Named(candidate.Person)</strong> (person @candidate.Person.Id),
                                        born @(candidate.Person.BirthDate?.ToString("yyyy-MM-dd") ?? "—")
                                        — @candidate.Verdict match
                                    </MudText>
                                    <MudButton id="@($"ecr-document-match-{m}-use")" Variant="Variant.Filled"
                                               Color="Color.Primary" Size="Size.Small" Disabled="@settling"
                                               OnClick="@(() => Settle(candidate.Person.Id))">
                                        Use this person
                                    </MudButton>
                                </div>
                            }
                        }
                        else if (matches?.Failure is { } whyNoMatches)
                        {
                            <MudText Typo="Typo.body2">@whyNoMatches</MudText>
                        }
                        <div>
                            <MudButton id="ecr-document-create-person" Variant="Variant.Outlined" Color="Color.Primary"
                                       Size="Size.Small" Disabled="@settling" OnClick="@(() => Settle(null))">
                                Create new person
                            </MudButton>
                        </div>
                    </div>
                }
            }
            else
            {
                <MudText id="ecr-document-no-cases" Typo="Typo.body2">
                    No case has been written from this eICR.
                </MudText>
            }
        </MudItem>
    </MudGrid>

    <MudText HtmlTag="h2" Typo="Typo.h6" Class="mt-6" GutterBottom="true">Validation findings</MudText>
    @if (detail.Findings.Count == 0)
    {
        <MudText id="ecr-document-no-findings" Typo="Typo.body2">Validation found nothing wrong.</MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudSimpleTable id="ecr-document-findings" Dense="true" Striped="true">
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Source</th>
                        <th>Document</th>
                        <th>Message</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in detail.Findings)
                    {
                        <tr data-ecr-finding-severity="@finding.Severity" data-ecr-finding-document="@finding.DocumentId">
                            <td>@finding.Severity</td>
                            <td>@finding.Source</td>
                            <td style="word-break: break-all;">@finding.DocumentKind @finding.DocumentId</td>
                            <td>@finding.Message</td>
                            <td style="word-break: break-all;">@(finding.Location ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}
else
{
    <MudAlert id="ecr-document-error" Severity="Severity.Error" Variant="Variant.Filled">@asked.Failure</MudAlert>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private Asked<EcrDocumentDetailResponse>? asked;

    private Asked<StagedMessagePersonMatchResponse>? matches;

    private bool mayEditCases;

    private bool settling;

    private string? settleFailure;

    protected override async Task OnParametersSetAsync()
    {
        asked = null;
        matches = null;
        settleFailure = null;

        // Settling writes cases, so it is offered to the holders of the
        // privilege the API tier asks of that write; the API tier still decides.
        var user = AuthenticationState is { } state ? (await state).User : null;
        mayEditCases = user?.HasClaim(AccountClient.PrivilegeClaim, Privileges.EditCases) == true;

        asked = await Client.Get(Id);

        if (mayEditCases && asked.Value?.CaseStatus == "review")
        {
            matches = await Client.PersonMatches(Id);
        }
    }

    /// <summary>
    /// Writes the held eICR to the cases of the person chosen, or of a new
    /// person where none is, and shows the document as it then stands.
    /// </summary>
    private async Task Settle(int? personId)
    {
        settling = true;
        settleFailure = null;

        try
        {
            var settled = await Client.Settle(Id, personId);

            if (settled.Value is not null)
            {
                asked = settled;
            }
            else
            {
                settleFailure = settled.Failure;
            }
        }
        finally
        {
            settling = false;
        }
    }

    private static string Named(PersonResponse person) =>
        string.IsNullOrWhiteSpace(person.FirstName)
            ? person.LastName
            : $"{person.LastName}, {person.FirstName}";

    /// <summary>A coded value as its name, with its code where both are given.</summary>
    private static string Shown(string? name, string? code) =>
        (name, code) switch
        {
            (not null, not null) => $"{name} ({code})",
            (not null, null) => name,
            (null, not null) => code,
            _ => "—",
        };
}
