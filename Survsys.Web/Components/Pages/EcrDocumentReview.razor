@* One eCR document with its pair: the eICR as the HL7 CDA stylesheet renders
   it, beside the RR's conditions with their determinations and responsible
   agencies, and below them what validation found in each document. An eICR
   can have more than one RR, so each finding names its document by kind and
   id.

   The rendering is the document's own text, so it is shown in an iframe with
   an empty sandbox: no scripts, no forms, no navigation of this page.

   Every element a later walkthrough will name carries an identifier of its
   own — `ecr-document-heading`, `-back`, `-loading`, `-error`, `-eicr`,
   `-no-eicr`, `-conditions`, `-no-conditions`, `-findings` and
   `-no-findings`. *@
@page "/ecr/{Id:int}"
@inject EcrClient Client

<PageTitle>eCR document — Survsys</PageTitle>

<MudText id="ecr-document-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    @(asked?.Value is { } loaded ? $"{loaded.Document.Kind} {loaded.Document.DocumentId}" : $"eCR document {Id}")
</MudText>

<MudButton id="ecr-document-back" Variant="Variant.Text" Href="/ecr" Class="mb-4">
    Back to the queue
</MudButton>

@if (asked is null)
{
    <MudProgressCircular id="ecr-document-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (asked.Value is { } detail)
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudText HtmlTag="h2" Typo="Typo.h6" GutterBottom="true">eICR</MudText>
            @if (detail.EicrHtml is null)
            {
                <MudText id="ecr-document-no-eicr" Typo="Typo.body2">
                    The eICR this response is for has not been received.
                </MudText>
            }
            else
            {
                <iframe id="ecr-document-eicr" title="The eICR" sandbox="" srcdoc="@detail.EicrHtml"
                        style="width: 100%; height: 80vh; border: 1px solid var(--mud-palette-lines-default);"></iframe>
            }
        </MudItem>
        <MudItem xs="12" md="5">
            <MudText HtmlTag="h2" Typo="Typo.h6" GutterBottom="true">Reportability response</MudText>
            @if (detail.Conditions.Count == 0)
            {
                <MudText id="ecr-document-no-conditions" Typo="Typo.body2">
                    No reportability response with conditions has been received for this eICR.
                </MudText>
            }
            else
            {
                <MudPaper Elevation="1">
                    <MudSimpleTable id="ecr-document-conditions" Dense="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Condition</th>
                                <th>Determination</th>
                                <th>Responsible agency</th>
                                <th>Report within</th>
                                <th>Maps to</th>
                                <th>Routing</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var condition in detail.Conditions)
                            {
                                <tr data-ecr-condition="@condition.ConditionCode">
                                    <td>@Shown(condition.ConditionName, condition.ConditionCode)</td>
                                    <td>
                                        @Shown(condition.DeterminationName, condition.DeterminationCode)
                                        @if (condition.LocationCode is not null)
                                        {
                                            <br /><MudText Typo="Typo.caption">@Shown(condition.LocationName, condition.LocationCode)</MudText>
                                        }
                                    </td>
                                    <td>@Shown(condition.ResponsibleAgencyName, condition.ResponsibleAgencyId)</td>
                                    <td>@(condition.ReportingTimeframe ?? "—")</td>
                                    <td data-ecr-mapped>@(condition.MappedConditionName ?? "—")</td>
                                    <td data-ecr-routing>
                                        @switch (condition.Routing)
                                        {
                                            case "reportable":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Reportable</MudChip>
                                                break;
                                            case "review":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Needs review</MudChip>
                                                break;
                                            default:
                                                <span>Not kept</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>

    <MudText HtmlTag="h2" Typo="Typo.h6" Class="mt-6" GutterBottom="true">Validation findings</MudText>
    @if (detail.Findings.Count == 0)
    {
        <MudText id="ecr-document-no-findings" Typo="Typo.body2">Validation found nothing wrong.</MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudSimpleTable id="ecr-document-findings" Dense="true" Striped="true">
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Source</th>
                        <th>Document</th>
                        <th>Message</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in detail.Findings)
                    {
                        <tr data-ecr-finding-severity="@finding.Severity" data-ecr-finding-document="@finding.DocumentId">
                            <td>@finding.Severity</td>
                            <td>@finding.Source</td>
                            <td style="word-break: break-all;">@finding.DocumentKind @finding.DocumentId</td>
                            <td>@finding.Message</td>
                            <td style="word-break: break-all;">@(finding.Location ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}
else
{
    <MudAlert id="ecr-document-error" Severity="Severity.Error" Variant="Variant.Filled">@asked.Failure</MudAlert>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Asked<EcrDocumentDetailResponse>? asked;

    protected override async Task OnParametersSetAsync()
    {
        asked = null;
        asked = await Client.Get(Id);
    }

    /// <summary>A coded value as its name, with its code where both are given.</summary>
    private static string Shown(string? name, string? code) =>
        (name, code) switch
        {
            (not null, not null) => $"{name} ({code})",
            (not null, null) => name,
            (null, not null) => code,
            _ => "—",
        };
}
