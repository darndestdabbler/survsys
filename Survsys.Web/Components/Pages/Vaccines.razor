@* The vaccine catalogue and its maintenance: every vaccine with its CDC code,
   description, sort order and whether it may still be chosen, a form that adds
   one or edits one, and a CSV export and an import previewed before it is
   saved. A vaccine is retired by clearing Active, never deleted, so a case's
   record that names it still shows it; the Vaccines tab offers only the
   active ones for a new record. *@
@page "/vaccines"
@inject VaccinesClient Client

<PageTitle>Vaccines — Survsys</PageTitle>

<MudText id="vaccines-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Vaccines
</MudText>

@if (failure is { } whyNot)
{
    <MudAlert id="vaccines-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        @whyNot
    </MudAlert>
}

@if (loading)
{
    <MudProgressCircular id="vaccines-loading" Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="d-flex gap-4 align-start mb-4">
        <MudButton id="vaccines-export" Variant="Variant.Outlined" Href="/vaccines/export" Target="_blank">
            Export vaccines CSV
        </MudButton>
        <div>
            <ImportPreview Prefix="vaccines-import" Label="Import vaccines CSV"
                           Import="@((csv, confirm) => Client.Import(csv, confirm))" Imported="@Load" />
        </div>
    </div>

    <MudPaper id="vaccine-form" Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">@(editingId is null ? "New vaccine" : "Edit vaccine")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="code" id="vaccine-code" Label="CDC code" Variant="Variant.Outlined"
                              Required="true" MaxLength="20" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="description" id="vaccine-description" Label="Description"
                              Variant="Variant.Outlined" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField @bind-Value="sortOrder" id="vaccine-sort-order" Label="Sort order"
                                 Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudCheckBox @bind-Value="active" id="vaccine-active" Label="Active" />
            </MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-4">
            <MudButton id="vaccine-save" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@saving" OnClick="@Save">
                Save
            </MudButton>
            <MudButton id="vaccine-new" Variant="Variant.Outlined" Disabled="@saving" OnClick="@Clear">
                New vaccine
            </MudButton>
        </div>
    </MudPaper>

    <MudSimpleTable id="vaccines-table" Dense="true" Hover="true">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Sort order</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in vaccines)
            {
                <tr id="@($"vaccine-row-{row.Id}")">
                    <td>@row.Code</td>
                    <td>@row.Description</td>
                    <td>@row.SortOrder</td>
                    <td>@(row.Active ? "Yes" : "No")</td>
                    <td>
                        <MudButton id="@($"vaccine-edit-{row.Id}")" Size="Size.Small"
                                   Variant="Variant.Text" OnClick="@(() => Edit(row))">
                            Edit
                        </MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private IReadOnlyList<VaccineResponse> vaccines = [];

    private int? editingId;

    private string? code;

    private string? description;

    private int sortOrder;

    private bool active = true;

    private bool loading = true;

    private bool saving;

    private string? failure;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        loading = false;
    }

    private async Task Load()
    {
        var loaded = await Client.Catalogue();
        vaccines = loaded.Value ?? [];
        failure ??= loaded.Failure;
    }

    private void Edit(VaccineResponse row)
    {
        editingId = row.Id;
        code = row.Code;
        description = row.Description;
        sortOrder = row.SortOrder;
        active = row.Active;
        failure = null;
    }

    private void Clear()
    {
        editingId = null;
        code = description = null;
        sortOrder = 0;
        active = true;
        failure = null;
    }

    private async Task Save()
    {
        saving = true;
        failure = null;

        var request = new SaveVaccineRequest(code ?? "", description, sortOrder, active);
        var saved = editingId is { } id
            ? await Client.SaveVaccine(id, request)
            : await Client.AddVaccine(request);

        saving = false;
        failure = saved.Failure;

        if (saved.Succeeded)
        {
            Clear();
            await Load();
        }
    }
}
