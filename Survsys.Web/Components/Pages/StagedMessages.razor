@* The inbound ELR intake queue: the staged messages waiting for a reviewer,
   as the staged-message endpoint returns them. One page of rows, oldest first,
   with a review-state filter above them, and each row a way into the message
   on its own.

   Every element a later walkthrough will name carries an identifier of its
   own — `staged-messages-heading`, `staged-messages-filter`,
   `staged-messages-total`, `staged-messages-loading`, `staged-messages-error`,
   `staged-messages-none`, the table, and one row per message keyed by its id.
   A test selects by those and not by a MudBlazor class or a cell's position.

   The review state is the stored code the wire carries; this tier reads
   Survsys.Contracts and not Survsys.Data, so the rule class that owns the
   vocabulary is out of reach here and the label is a handful of literals, as
   the work-queue screen maps its workflow codes for display. *@
@page "/staged-messages"
@inject MessageQueueClient Client

<PageTitle>Staged messages — Survsys</PageTitle>

<MudText id="staged-messages-heading" HtmlTag="h1" Typo="Typo.h4" GutterBottom="true">
    Staged messages
</MudText>

<MudText Typo="Typo.body2" Class="mb-4">
    The inbound electronic lab reports waiting for review. Filter by review
    state, or leave it on All to see the whole queue.
</MudText>

<MudSelect id="staged-messages-filter" T="string" Label="Review state" Value="status"
           ValueChanged="OnFilterChanged" Dense="true" Class="mb-4" Style="max-width: 20rem;">
    <MudSelectItem T="string" Value="@AllStates">All</MudSelectItem>
    @foreach (var state in States)
    {
        <MudSelectItem T="string" Value="@state.Code">@state.Label</MudSelectItem>
    }
</MudSelect>

@if (asked is null)
{
    <MudProgressCircular id="staged-messages-loading" Color="Color.Primary" Indeterminate="true" />
}
else if (asked.Value is { } result)
{
    <MudText id="staged-messages-total" Typo="Typo.body2" Class="mb-4">
        @result.TotalCount message(s), showing @result.Items.Count.
    </MudText>

    @if (result.Items.Count == 0)
    {
        <MudText id="staged-messages-none" Typo="Typo.body2">
            No messages are in this part of the queue.
        </MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudSimpleTable id="staged-messages-table" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Received</th>
                        <th>Review state</th>
                        <th>QA</th>
                        <th>Exception</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in result.Items)
                    {
                        <tr id="@($"staged-message-row-{message.Id}")" data-staged-message="@message.Id">
                            <td data-staged-message-source>
                                <MudLink Href="@($"/staged-messages/{message.Id}")">
                                    @(string.IsNullOrWhiteSpace(message.Source) ? "—" : message.Source)
                                </MudLink>
                            </td>
                            <td data-staged-message-received>@message.ReceivedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td data-staged-message-state>@Label(message.ReviewStatus)</td>
                            <td data-staged-message-qa>@(message.QaFlagged ? "Flagged" : "—")</td>
                            <td data-staged-message-exception>@(string.IsNullOrWhiteSpace(message.ExceptionDetail) ? "—" : message.ExceptionDetail)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        @if (result.TotalCount > PageSize || page > 1)
        {
            <div class="d-flex align-center gap-4 mt-2">
                <MudButton id="staged-messages-prev" Variant="Variant.Outlined" Size="Size.Small"
                           Disabled="@(page <= 1)" OnClick="PreviousPage">
                    Previous
                </MudButton>
                <MudText id="staged-messages-page" Typo="Typo.body2">Page @(page) of @LastPage</MudText>
                <MudButton id="staged-messages-next" Variant="Variant.Outlined" Size="Size.Small"
                           Disabled="@(page >= LastPage)" OnClick="NextPage">
                    Next
                </MudButton>
            </div>
        }
    }
}
else
{
    @* The tier's contract: an API failure is a message on the screen, never
       an unhandled exception in a circuit. MessageQueueClient hands over the
       message; this is where it is shown. *@
    <MudAlert id="staged-messages-error" Severity="Severity.Error" Variant="Variant.Filled">
        @asked.Failure
    </MudAlert>
}

@code {
    /// <summary>The value the filter holds for "every review state".</summary>
    private const string AllStates = "";

    /// <summary>
    /// How many messages one page of this screen holds. The API tier's own
    /// default, stated here because a screen that shows a count has to know
    /// what it asked for.
    /// </summary>
    private const int PageSize = 50;

    /// <summary>
    /// The review states a message can be filtered to, their stored codes and
    /// the labels shown for them. The codes are the wire's; the API tier owns
    /// the vocabulary, and this list is display only, as the work-queue
    /// screen's workflow mapping is. Entry, Pending and Exception are the
    /// states the intake queue holds.
    /// </summary>
    private static readonly IReadOnlyList<(string Code, string Label)> States =
    [
        ("entry", "Queued for review"),
        ("pending", "Held for review"),
        ("exception", "Exception"),
    ];

    private string status = AllStates;

    private int page = 1;

    private Asked<PagedResult<StagedMessageResponse>>? asked;

    private int LastPage => Math.Max(1, ((asked?.Value?.TotalCount ?? 0) + PageSize - 1) / PageSize);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        asked = null;
        asked = await Client.Page(string.IsNullOrEmpty(status) ? null : status, page, PageSize);
    }

    private async Task OnFilterChanged(string chosen)
    {
        status = chosen ?? AllStates;
        page = 1;
        await Load();
    }

    private async Task PreviousPage()
    {
        if (page > 1)
        {
            page--;
            await Load();
        }
    }

    private async Task NextPage()
    {
        if (page < LastPage)
        {
            page++;
            await Load();
        }
    }

    /// <summary>
    /// A review-state code read as its label, falling back to the code itself
    /// for one this screen does not list — a later session's states read as
    /// their code rather than as nothing.
    /// </summary>
    private static string Label(string reviewStatus)
    {
        foreach (var state in States)
        {
            if (state.Code == reviewStatus)
            {
                return state.Label;
            }
        }

        return reviewStatus;
    }
}
