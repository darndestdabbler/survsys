@* The Attachments section of a case morbidity report's Notes tab: the files
   attached to the report, newest first, and an inline panel that attaches
   another.

   ../nedss/docs/functional/session-012-investigation-admin-contacts-notes.md
   records the legacy Notes tab as three sections — Attachments, Notes and
   Tasks — and this is the first of them, which session 26 left for this one.
   The legacy panel shows "No attachments found" until something is attached
   and opens its upload dialog from a "+ Attachment" button; this opens
   inline, as the note entry panel does, because a dialog here would be a
   mechanism the tab has nowhere else.

   The category select offers the five the legacy dialog offers, under the
   legacy's own labels and writing the legacy's own codes, which are the five
   the API tier accepts.

   The file picker is Blazor's own InputFile and not a component that hides
   it, so the input a walkthrough types a path into is the input this markup
   names. The accept list and the size ceiling are this tier's convenience:
   what may be attached is the API tier's to say, and it says so by refusing.

   There is no download link and no delete. The bytes are the API tier's to
   serve and this tier cannot hand them on without either giving the browser
   that tier's address or proxying the file, and an attachment is stored once.

   A row in a list carries its position in its identifier, so a walkthrough
   can name it: attachments-file-0, attachments-file-0-filename and so on. *@
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject AttachmentsClient Api

@if (listFailure is { } whyNoList)
{
    <MudAlert id="attachments-list-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        @whyNoList
    </MudAlert>
}

@if (saved is { } stored)
{
    <MudAlert id="attachments-entry-saved" Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
        @stored
    </MudAlert>
}

@if (entryFailure is { } whyNot)
{
    <MudAlert id="attachments-entry-error" Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        @whyNot
    </MudAlert>
}

@if (complaint is { } whyNotYet)
{
    <MudAlert id="attachments-entry-complaint" Severity="Severity.Warning" Class="mb-4">
        @whyNotYet
    </MudAlert>
}

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Attachments</MudText>
    @if (attachments.Count == 0)
    {
        <MudText id="attachments-none" Typo="Typo.body2">No attachments found.</MudText>
    }
    else
    {
        <MudSimpleTable id="attachments-files" Hover="true" Striped="true">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Category</th>
                    <th>Size</th>
                    <th>Type</th>
                    <th>Attached</th>
                </tr>
            </thead>
            <tbody>
                @for (var a = 0; a < attachments.Count; a++)
                {
                    var attachment = attachments[a];
                    <tr id="@($"attachments-file-{a}")" @key="attachment.Id">
                        <td id="@($"attachments-file-{a}-filename")">@attachment.Filename</td>
                        <td id="@($"attachments-file-{a}-category")">@Labelled(attachment.Category)</td>
                        <td id="@($"attachments-file-{a}-size")">@Sized(attachment.Size)</td>
                        <td id="@($"attachments-file-{a}-content-type")">@attachment.ContentType</td>
                        <td id="@($"attachments-file-{a}-created-at")">@Attached(attachment.CreatedAt)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

<MudPaper id="attachments-entry" Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Add an attachment</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="category" id="attachments-entry-category"
                       Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@Correspondence">Correspondence</MudSelectItem>
                <MudSelectItem T="string" Value="@Lab">Laboratory results</MudSelectItem>
                <MudSelectItem T="string" Value="@Letter">Letter</MudSelectItem>
                <MudSelectItem T="string" Value="@XRay">X-ray</MudSelectItem>
                <MudSelectItem T="string" Value="@Other">Other</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="8" Class="d-flex align-center">
            <InputFile id="attachments-entry-file" OnChange="Chosen" accept="@Accepted" />
        </MudItem>
        <MudItem xs="12">
            <MudText id="attachments-entry-chosen" Typo="Typo.body2">
                @(chosen is { } file ? $"{file.Name} ({Sized(file.Size)})" : "No file chosen.")
            </MudText>
        </MudItem>
    </MudGrid>

    <div class="d-flex gap-2 mt-4">
        <MudButton id="attachments-entry-upload" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@uploading" OnClick="@Upload">
            Attach file
        </MudButton>
    </div>
</MudPaper>

@code {
    /// <summary>The report whose attachments this panel lists and attaches to.</summary>
    [Parameter, EditorRequired]
    public int ReportId { get; set; }

    /// <summary>
    /// The category codes the API tier files an attachment under, as its
    /// vocabulary holds them. Named here as constants rather than typed into
    /// the markup twice, because the select writes the same code the API
    /// validates.
    /// </summary>
    private const string Correspondence = "correspondence";

    /// <summary>The code laboratory results are filed under.</summary>
    private const string Lab = "lab";

    /// <summary>The code a letter is filed under.</summary>
    private const string Letter = "letter";

    /// <summary>The code an x-ray is filed under.</summary>
    private const string XRay = "x-ray";

    /// <summary>The code anything else is filed under.</summary>
    private const string Other = "other";

    /// <summary>
    /// What the file dialog offers to open, which is the list of types the API
    /// tier stores.
    /// </summary>
    /// <remarks>
    /// A convenience and not a check: a browser is free to ignore it, and the
    /// API tier refuses a type it does not store whatever was chosen here.
    /// </remarks>
    private const string Accepted =
        "application/pdf,text/plain,text/csv,application/msword,"
        + "application/vnd.openxmlformats-officedocument.wordprocessingml.document,"
        + "image/png,image/jpeg,image/gif,image/tiff";

    /// <summary>
    /// How this tier writes the moment a file was attached: the day, as every
    /// other date on a report's screens is written.
    /// </summary>
    private const string DateForm = "yyyy-MM-dd";

    private List<AttachmentResponse> attachments = [];

    private string? category = Correspondence;

    private IBrowserFile? chosen;

    private bool uploading;

    private string? listFailure;

    private string? saved;

    private string? entryFailure;

    private string? complaint;

    protected override async Task OnInitializedAsync()
    {
        // Every attachment of the report, however many pages the API tier
        // lists them over: the client walks the pages, so none is left off the
        // end of the list. Metadata only -- no file is read to show this.
        var listed = await Api.All(ReportId);

        if (listed.Value is not { } filed)
        {
            listFailure = listed.Failure;

            return;
        }

        attachments = [.. filed];
    }

    /// <summary>What the file picker now holds, which is at most one file.</summary>
    private void Chosen(InputFileChangeEventArgs chose)
    {
        chosen = chose.FileCount > 0 ? chose.File : null;
        complaint = null;
        entryFailure = null;
        saved = null;
    }

    private async Task Upload()
    {
        // The two things checked here are the two a user can put right without
        // sending anything: that a file was chosen at all, and that it is not
        // larger than the API tier will take. The type, the category and
        // everything else that tier refuses is shown as the entry error rather
        // than re-checked here.
        if (chosen is not { } file)
        {
            complaint = "Choose a file before attaching it.";

            return;
        }

        if (file.Size > AttachmentsClient.MaxBytes)
        {
            complaint =
                $"{file.Name} is {Sized(file.Size)}, and the largest file this system stores "
                + $"is {Sized(AttachmentsClient.MaxBytes)}. Attach a smaller file.";

            return;
        }

        complaint = null;
        entryFailure = null;
        saved = null;
        uploading = true;

        try
        {
            await using var content = file.OpenReadStream(AttachmentsClient.MaxBytes);

            var answered = await Api.Attach(
                ReportId, file.Name, file.ContentType, category, content);

            if (answered.Value is { } stored)
            {
                // The new attachment goes to the top of the list, which is
                // where the API tier's own newest-first ordering would put it.
                attachments.Insert(0, stored);
                saved = $"{stored.Filename} has been attached.";

                // The picker still holds the file it sent, and nothing here
                // can empty it; forgetting it is what stops a second press of
                // the button attaching the same file twice.
                chosen = null;
            }
            else
            {
                entryFailure = answered.Failure;
            }
        }
        finally
        {
            uploading = false;
        }
    }

    /// <summary>A category as the legacy dialog labels it, or the code itself
    /// where this tier has no label for it.</summary>
    private static string Labelled(string category) => category switch
    {
        Correspondence => "Correspondence",
        Lab => "Laboratory results",
        Letter => "Letter",
        XRay => "X-ray",
        Other => "Other",
        _ => category,
    };

    /// <summary>
    /// A file's size as a list shows it: bytes under a kilobyte, and a round
    /// number of the largest unit that fits above it.
    /// </summary>
    private static string Sized(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024} KB",
        _ => ((double)bytes / (1024 * 1024)).ToString("0.0", CultureInfo.InvariantCulture) + " MB",
    };

    /// <summary>The day a file was attached, in the report screens' date form.</summary>
    private static string Attached(DateTimeOffset attached) =>
        attached.ToString(DateForm, CultureInfo.InvariantCulture);
}
