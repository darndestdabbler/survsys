<Project Sdk="Microsoft.NET.Sdk">

  <!-- The intake module: it turns a raw HL7 v2.5.1 message from a lab into
       the Survsys.Contracts intake records the rest of the system already
       speaks. It references nHapi to parse and Survsys.Contracts to land the
       result, and nothing of the database: never Survsys.Data and never
       Entity Framework Core, so the parse can never reach past the wire
       shapes. The architecture test reads that fence off this assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nHapi.Base" Version="3.2.3" />
    <PackageReference Include="nHapi.Model.V251" Version="3.2.4" />
  </ItemGroup>

  <!-- The HL7 CDA schema, eCR schematrons and vocabularies, the ISO
       Schematron skeleton and the HL7 CDA stylesheet, as published (see
       Cda/README.md). They are read from disk beside the assembly, where
       their relative includes and document() calls resolve, so they are
       copied to the output of this project and of every project that
       references it. -->
  <ItemGroup>
    <None Include="Cda\**\*" Exclude="Cda\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Survsys.Contracts\Survsys.Contracts.csproj" />
  </ItemGroup>

</Project>
