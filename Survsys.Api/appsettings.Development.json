{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // The SQL each query sends, which is worth seeing while a slice is
      // being built and worth nothing in production.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  // The development database on this host's default SQL Server instance.
  // Integrated security, so there is no password here and none to leak: the
  // developer's own Windows account is what authenticates.
  "ConnectionStrings": {
    "Survsys": "Server=localhost;Database=survsys;Trusted_Connection=True;TrustServerCertificate=True"
  },
  // CT's testing and staging receiver, which a development message names in
  // MSH-5 in place of the production one.
  "Conformance": {
    "ConnecticutReceivingApplicationOid": "2.16.840.1.113883.3.5609.4.1.1.3.2.2"
  }
}
