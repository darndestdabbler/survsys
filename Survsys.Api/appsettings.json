{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The key the API tier reads, declared here and deliberately left empty: a
  // deployment supplies it, and startup refuses rather than guessing. It
  // never holds a password, because SQL Server authentication is integrated
  // and the string therefore carries no credential.
  "ConnectionStrings": {
    "Survsys": ""
  },
  // The inbound ELR intake, deliberately off: the drop directory is empty, so
  // the background worker logs once and does nothing until a deployment points
  // it at a directory. The intervals are the defaults a turned-on deployment
  // inherits unless it overrides them.
  "ElrIntake": {
    "DropDirectory": "",
    "PollIntervalSeconds": 120,
    "MessageTimeoutSeconds": 30
  },
  // Direct transmission of a generated notification to CDC, deliberately off:
  // an empty endpoint leaves transmission off the way an empty ElrIntake drop
  // directory leaves the intake off, so a deployment that notifies CDC points
  // this at the receiving endpoint and one that does not is left alone. The
  // timeout is the default a turned-on deployment inherits unless it overrides
  // it.
  "CdcTransmission": {
    "Endpoint": "",
    "TimeoutSeconds": 30
  },
  // The scores person matching divides candidates at: at or above Exact is the
  // same person, below Probable is not, and between them is a probable match a
  // reviewer confirms.
  "PersonMatching": {
    "Exact": 95,
    "Probable": 70
  }
}
