{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The key the API tier reads, declared here and deliberately left empty: a
  // deployment supplies it, and startup refuses rather than guessing. It
  // never holds a password, because SQL Server authentication is integrated
  // and the string therefore carries no credential.
  "ConnectionStrings": {
    "Survsys": ""
  },
  // The inbound ELR intake, deliberately off: the drop directory is empty and
  // the MLLP port null, so the file drop and the MLLP listener each log once and
  // do nothing until a deployment points one at a directory or a port. The
  // intervals are the defaults a turned-on deployment inherits unless it
  // overrides them.
  "ElrIntake": {
    "DropDirectory": "",
    "MllpPort": null,
    "PollIntervalSeconds": 120,
    "MessageTimeoutSeconds": 30
  },
  // HL7 conformance at intake, deliberately off: no sender has a profile until
  // a deployment maps a sending facility's MSH-4.1 to one ("LAB": "CT"). The
  // Connecticut OIDs are CT's production receiver's; Development names the
  // testing receiver's MSH-5 instead.
  "Conformance": {
    "ConnecticutReceivingApplicationOid": "2.16.840.1.113883.3.5609.4.1.1.3.2.1",
    "ConnecticutReceivingFacilityOid": "2.16.840.1.113883.3.5609.4.1",
    "SenderProfiles": {}
  },
  // Which of an address's two county values each program reports: "county"
  // (for Connecticut, the historical county) or "county-equivalent" (the
  // planning region). ELR and eCR still carry the historical county; CDC
  // expects the planning region.
  "CountyPrograms": {
    "elr": "county",
    "ecr": "county",
    "cdc-notification": "county-equivalent"
  },
  // Automatic assignment and the graylist, deliberately off: a null poll
  // interval leaves every queued message for a reviewer. An empty home state
  // sends no message out of state; the retention is the legacy 18 months a
  // graylisted message waits for a case before it is pruned. The whitelist rule
  // chooses the open case a message updates: a case whose event date is within
  // 90 days before the specimen's collection, unless a condition, by its CDC
  // code (or its name where it has none), has a rule of its own (Exception, Newest, NeverNew, AlwaysNew, TimeOnset
  // with Days, BeforeAfter with DaysBefore and DaysAfter; IgnoreCaseStatus).
  // Reprocessing, off while its interval is null, retries every so many
  // minutes each message held for a retryable reason, up to MaxRetries times.
  "MessageProcessing": {
    "PollIntervalSeconds": null,
    "HomeState": "",
    "GraylistRetentionDays": 548,
    "ReprocessIntervalMinutes": null,
    "MaxRetries": 3,
    "Whitelist": {
      "Type": "TimeOnset",
      "Days": 90,
      "IgnoreCaseStatus": false
    },
    "WhitelistByCondition": {}
  },
  // The batch e-mail of assigned messages to each agency's notification
  // addresses, deliberately off: a null interval and an empty host and sender
  // leave it inert. The user name and password come from the deployment's
  // environment or secret store, never this file.
  "MessageNotification": {
    "IntervalMinutes": null,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "From": "",
    "UserName": ""
  },
  // Transmission of a generated notification to CDC, deliberately off: the
  // transport is Http (a POST to the endpoint) or File (one .hl7 file per
  // message written into the outbox a PHINMS or AIMS sender picks up), and an
  // empty endpoint or outbox leaves it off the way an empty ElrIntake drop
  // directory leaves the intake off. A user name signs the POST in with Basic
  // credentials; the password comes from the deployment's environment or
  // secret store (CdcTransmission__Password), never this file. The timeout is
  // the default a turned-on deployment inherits unless it overrides it.
  "CdcTransmission": {
    "Transport": "Http",
    "Endpoint": "",
    "OutboxDirectory": "",
    "UserName": "",
    "TimeoutSeconds": 30
  },
  // The export queue worker, deliberately off: a null interval leaves each
  // released case on the queue until "process queue now" is asked for. The
  // processing id (Production, Training, Debug) is written to MSH-11 as P, T
  // or D; the queue (Production, Onboarding, Batch) is recorded on each log row.
  // Each pass, timed or "process queue now", first deletes export-log rows queued more than the retention's
  // days ago; null keeps every row.
  "NotificationQueue": {
    "PollIntervalSeconds": null,
    "ProcessingId": "Production",
    "Queue": "Production",
    "ExportLogRetentionDays": null
  },
  // The scores person matching divides candidates at: at or above Exact is the
  // same person, below Probable is not, and between them is a probable match a
  // reviewer confirms.
  "PersonMatching": {
    "Exact": 95,
    "Probable": 70
  }
}
