<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one project that references every module, because it is the
       project that reads their reference graphs. That is a consequence of
       the architecture tests, not a licence for anything else. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- HL7 fixtures the parser tests read, copied beside the test assembly
         so OruR01ParserTests finds them under Fixtures/Hl7 at run time. -->
    <None Include="Fixtures\Hl7\*.hl7" CopyToOutputDirectory="PreserveNewest" />
    <!-- The HL7 eCR implementation guides' sample documents, unchanged, for
         CdaParserTests and EcrIntakeServiceTests under Fixtures/Cda. -->
    <None Include="Fixtures\Cda\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Survsys.Contracts\Survsys.Contracts.csproj" />
    <ProjectReference Include="..\Survsys.Data\Survsys.Data.csproj" />
    <ProjectReference Include="..\Survsys.Api\Survsys.Api.csproj" />
    <ProjectReference Include="..\Survsys.Web\Survsys.Web.csproj" />
    <ProjectReference Include="..\Survsys.Messaging\Survsys.Messaging.csproj" />
  </ItemGroup>

</Project>
